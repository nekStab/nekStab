[GENERAL]

startFrom = 1cyl0.f00001
endTime = 200.0

stopAt = endTime
userParam01 = 0 # DNS mode

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5
#extrapolation = OIFS

writeControl = runTime
writeInterval = 100.0
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-06
residualProj = yes
writeToFieldFile = no

[VELOCITY]
residualTol = 1.0E-06
residualProj = no
density = 1.0
viscosity = -150.0
