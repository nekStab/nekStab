[GENERAL]
startFrom = BFRe40_1cyl0.f00001

stopAt = endTime
endTime = 0

userParam01 = 2  # 2.0: Newton-Krylov for a steady base flow (see DOC.md for all codes)
userParam02 = 0  # krylov snapshot to load
userParam03 = 0  # not used by mode 2.0
userParam04 = 0  # freq (Strouhal leading mode)
userParam05 = 0   # gain (twice growth rate leading mode)
userParam06 = 0 # Ri > 0 for heating
userParam07 = 0 # k_dim
userParam08 = 0   # sponge lenght left
userParam09 = 0   # sponge lenght right
userParam10 = 0   # sponge strenght

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 10.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-13
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-13
residualProj = no
density = 1.0
viscosity = -80.0

#[TEMPERATURE]
#solver = helm
#residualTol = 1.0E-11
#residualProj = yes
#writeToFieldFile = yes
#conductivity = -40.0
#rhoCp = 1.0
