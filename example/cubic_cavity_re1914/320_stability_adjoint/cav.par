[GENERAL]
# TEMPLATE: converged baseflow
startFrom = BF_cav0.f00001

stopAt = endTime
endTime = 2.0          # Arnoldi window: omega of the leading pair is 0.587, so omega*T = 1.2 < pi (no aliasing)

userParam01 = 3.2        # 3.2 = adjoint stability
userParam03 = 6          # schur_tgt: converge the 6 leading eigenvalues
userParam07 = 120        # k_dim
userParam08 = 0          # sponge left
userParam09 = 0          # sponge right
userParam10 = 0          # sponge strength

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.0
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -1914.0   # Re=1914
