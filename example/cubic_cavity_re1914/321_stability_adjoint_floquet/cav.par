[GENERAL]
# TEMPLATE: UPO checkpoint (output of Newton 2.1)
startFrom = BF_cav0.f00001

stopAt = endTime
endTime = 1.0            # placeholder; nekStab adjusts to UPO period

userParam01 = 3.21       # 3.21 = adjoint Floquet (periodic adjoint over one UPO period)
userParam07 = 100        # k_dim (Floquet usually needs larger subspace)
userParam08 = 0          # sponge left
userParam09 = 0          # sponge right
userParam10 = 0          # sponge strength

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.0
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-7
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -1914.0   # Re=1914
