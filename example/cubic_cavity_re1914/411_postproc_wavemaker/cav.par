[GENERAL]
# The run reads the base flow BF_cav0.f00001 and the eigenmodes of the stages 310 and 320, and writes fields. It takes no time steps.
startFrom = 0
stopAt = endTime
endTime = 0

userParam01 = 4        # post-processing: energy budget (4.1), wavemaker (4.2) and sensitivity to base-flow changes (4.3)

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 10.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -1914.0   # Re=1914
