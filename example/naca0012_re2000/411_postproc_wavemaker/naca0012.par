[GENERAL]
startFrom = 0  # wavemaker reads mode files directly, no IC needed
stopAt = endTime
endTime = 0
userParam01 = 4  # wavemaker + bf_sensitivity (Mode 4)
userParam08 = 1  # Sponge left side
userParam09 = 5  # Sponge right side
userParam10 = 1.7  # Sponge strength

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -2000.0
