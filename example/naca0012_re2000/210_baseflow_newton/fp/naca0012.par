[GENERAL]
startFrom = BF_naca00120.f00001

stopAt = endTime
endTime = 0.09 # sampling period approximated as (1/1.41)/8

userParam01 = 2.0 # Newton
#userParam01 = 3.1 # Direct

userParam07 = 220 # k_dim
userParam08 = 1   # Sponge left side
userParam09 = 5   # Sponge right side
userParam10 = 1.7 # Sponge streght

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5
#extrapolation = OIFS

writeControl = runTime
writeInterval = 10.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
# Velocity residual projection off: with it the Newton run stops with a non-finite
# norm at 24 or more ranks on Jean Zay (ifort). Off, it converges at 8 to 40 ranks.
residualProj = no
density = 1.0
viscosity = -2000.0 # Re_c ~ 
