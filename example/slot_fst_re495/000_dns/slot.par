#
# DNS phase: generate initial condition from scratch (Re=495)
# Runs from t=0 to t=100, saving the final snapshot.
#
[GENERAL]
startFrom = 0

stopAt = endTime
endTime = 100

userParam01 = 0  # DNS mode
userParam06 = 0.35 # amplitude R -> jet at \overline{R}=2*R
userParam07 = 0.3603 # delta*/D

dt = 0
variableDt = yes
timeStepper = bdf3
extrapolation = OIFS
targetCFL = 3

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes

filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-8
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-8
residualProj = no
density = 1.0
viscosity = -495.0
