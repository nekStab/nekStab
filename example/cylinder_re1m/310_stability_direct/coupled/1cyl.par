[GENERAL]
startFrom = base_converged.f00001 # imperfect SFD base, not a mean and not a fixed point (residual ~5e-4)
stopAt = endTime
endTime = 1.0      # sampling period per Arnoldi vector (~1/5 leading-mode period at St=0.192); NOT a long DNS

userParam01 = 3.1   # direct stability (FD-Frechet via iffindiff in .usr)
userParam02 = 0     # krylov snapshot to load - output frequency for statistics
userParam03 = 0     # stabilization technique: 1:sfd - surface
# Akervik
# userParam04 = 0.25   # freq (Strouhal leading mode)
# userParam05 = 0.25   # gain (twice growth rate leading mode)
# Casacuberta
userParam04 = -0.192   # freq (measured leading-mode St from the wake probe FFT)
userParam05 = 0.147   # sigma
userParam06 = 0     # AoA
userParam07 = 100   # k_dim. The coupled operator is a documented NEGATIVE result:
                    # its near-wall k-tau continuum (sigma~2.5-3.9) buries the
                    # physical wake mode; doubling k_dim->200 only lowered the floor
                    # 2.50->2.27 (see Spectre_NSd_kdim100.dat vs the kdim200 run).
userParam08 = 0     # sponge lenght left
userParam09 = 0     # sponge lenght right
userParam10 = 0     # sponge strenght

dt = 0.005 # constant dt for the linear operator; CFL~0.5 (no OIFS). Small because the
           # k-tau source is stiff (a CFL=5 march blew up at t=8.5) and a small dt keeps
           # the FD-Frechet integration clean. variableDt off = consistent Frechet operator.
variableDt = no
timeStepper = bdf3

writeControl = runTime
writeInterval = 10.0
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 1.0
filterCutoffRatio = 0.67   # N=5, top 2 modes. This solve made wall modes leading.

[PROBLEMTYPE]
variableProperties = yes
stressFormulation = yes

[MESH]
numberOfBCFields = 1

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0e-5
residualProj = yes

[VELOCITY]
density = 1.0
viscosity = -1000000.0   # Re=1e6 (RANS; user-directed)
residualTol = 1.0e-6

[TEMPERATURE] # keep temp field on !
solver = none
rhoCp = 1.0
conductivity = -1 # -Pe = Re*Pr
residualTol = 1.0e-6

[SCALAR01] #tke
density = 1.0
diffusivity = -1000000.0
residualTol = 1.0e-6

[SCALAR02] #tau
density = 1.0
diffusivity = -1000000.0
residualTol = 1.0e-6