[GENERAL]
# TEMPLATE: converged baseflow
startFrom = BF_case0.f00001

stopAt = endTime
endTime = 1.0

userParam01 = 4.11       # 4.11 = energy budget / sensitivity (Floquet variant)
# Reads pre-existing direct + adjoint eigenmodes (dRe*, dIm*, aRe*, aIm*)
# from the run directory and assembles wavemaker / production fields.

userParam08 = 5          # sponge left (match upstream stability run)
userParam09 = 5          # sponge right
userParam10 = 1.7        # sponge strength

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1.0
writeDoublePrecision = yes

dealiasing = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -100.0       # TEMPLATE: -Re (match upstream stability run)
