[GENERAL]
# TEMPLATE: SFD with a dynamic solver tolerance; userParam01 = 1.1
# Set ifdyntol = .true. in nekStab_usrchk of the .usr file. Every userParam09 steps the velocity solver tolerance is set to
# userParam08 times the SFD residual, and never below the convergence gate (src/fixedp.f90).
# Working stage: example/cylinder_re100/110_baseflow_sfd/akervik_dyn (factor 0.9, stride 100)
startFrom = BF_seed_case0.f00001

stopAt = endTime
endTime = 400.0

userParam01 = 1.1        # SFD with dynamic tolerance
userParam04 = 0.12       # TEMPLATE: f = omega / 2 pi of the leading mode (Strouhal number); positive Akervik, negative Casacuberta
userParam05 = 0.05       # TEMPLATE: sigma, growth rate of that mode
userParam08 = 0.9        # factor of the solver tolerance over the SFD residual
userParam09 = 100        # stride of the update, in steps

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1000.0
writeDoublePrecision = no

dealiasing = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -100.0       # TEMPLATE: -Re
