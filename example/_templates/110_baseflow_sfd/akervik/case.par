[GENERAL]
# TEMPLATE: SFD classical, Akervik et al. (2006); userParam01 = 1.1 with userParam04 > 0
# Ref: Akervik et al., Phys. Fluids 18, 068102 (2006)
# f and sigma come from the leading eigenvalue of the direct stability stage 310: omega = 2 pi f, sigma = its growth rate.
# The filter has the cutoff omega / 2 and the gain -2 sigma (DOC.md).
# Working stage: example/cylinder_re100/110_baseflow_sfd/akervik (f = 0.166, sigma = 0.26)
startFrom = BF_seed_case0.f00001

stopAt = endTime
endTime = 400.0          # TEMPLATE: long enough for SFD residual to decay

userParam01 = 1.1        # SFD classical
userParam04 = 0.12       # TEMPLATE: f = omega / 2 pi of the leading mode (Strouhal number); positive selects Akervik
userParam05 = 0.05       # TEMPLATE: sigma, growth rate of that mode

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1000.0
writeDoublePrecision = no

dealiasing = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -100.0       # TEMPLATE: -Re
