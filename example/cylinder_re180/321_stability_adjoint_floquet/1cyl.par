[GENERAL]
startFrom = BF_1cyl0.f00001 # here UPO file

stopAt = endTime
endTime = 1.0 # time will be adjusted from the UPO file

userParam01 = 3.21  # Adjoint Floquet
userParam07 = 100 # k_dim
userParam08 = 5   # Sponge left side
userParam09 = 5   # Sponge right side
userParam10 = 0   # sponge off: it also forces the base flow, so the orbit would differ from the Newton orbit (210)

dt = 0.004   # fixed step, 1298 per period (the Newton stage averages 4.4e-3)
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -180.0 # Re=180 (Barkley-Henderson Mode A threshold; was -50 historical seed)
