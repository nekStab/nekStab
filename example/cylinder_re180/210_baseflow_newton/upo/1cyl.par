[GENERAL]
startFrom = rstcyl0.f00001

stopAt = endTime
endTime = 5.22130 # period guess from a long Re=175 DNS: 172-cycle count + PSD peak (St=0.1915, Q~100) agree to 5 sig figs. Far sharper than the old Re=170 5.251.
userParam01 = 2.1 # Newton-GMRES for UPOs
userParam07 = 100 # k_dim

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 10.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -180.0 # Re=180 (Barkley-Henderson Mode A threshold; was -100 historical)
