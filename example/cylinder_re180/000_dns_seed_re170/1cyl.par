[GENERAL]
# Side-DNS at Re=150 to produce rstcyl0.f00001 seed for Re=180 Newton UPO (#79 chain)
startFrom = 1cyl0.f00004

stopAt = endTime
endTime = 1100.0   # 100 periods of clean Re=170 shedding for precise FFT

userParam01 = 0    # plain DNS mode

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 25.0   # snapshots for on-orbit IC
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-7
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -170.0   # Re=170 (IC + period source for Re=180 UPO)
