[GENERAL]
# DNS at Re=180 from rest. The 2D wake settles on its stable limit cycle; the last
# checkpoint seeds the Newton UPO (210) and the wake probe (1cyl.his) gives its period.
startFrom = 0

stopAt = endTime
endTime = 300.0   # from rest: the wake reaches the Re=180 limit cycle by t ~ 150; t = 150-300 gives ~29 periods for the period count

userParam01 = 0    # plain DNS mode

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.0   # checkpoints at t = 100, 200, 300; the last one (1cyl0.f00003) is the Newton seed
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-7
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -180.0   # Re=180: the 2D limit cycle is stable here, so the DNS lands on the exact orbit the Newton stage refines
