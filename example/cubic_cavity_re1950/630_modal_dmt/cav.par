[GENERAL]
# Start: the on-orbit checkpoint of ../000_dns_period at t = 1700 (ic_sat.f00001); the time is set to 0.
startFrom = ic_sat.f00001 time=0

stopAt = endTime
endTime = 161.83635  # 15 periods of the limit cycle, 15 * 10.78909

userParam01 = 6.4  # DMT filter bank on the DNS: filters at the frequency of the cycle, its harmonics and 0

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 161.83635  # one snapshot, at the end
writeDoublePrecision = yes  # single-precision 3D snapshots hang the Nek MPI-IO read on 16 ranks

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-6
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-6
residualProj = yes
density = 1.0
viscosity = -1950.0
