[GENERAL]
# BF_cav0.f* UPO snapshots come from root Newton UPO output;
# bootstrap with: cp ../BF_cav0.f00001 ./BF_cav0.f00001
startFrom = BF_cav0.f00001

stopAt = endTime
endTime = 10.7737861323877  # one UPO period T (Floquet integrates over T)

userParam01 = 3.11  # Direct Floquet stability around UPO
userParam07 = 192   # k_dim — raised from 92 so the Schur loop sees enough basis vectors to converge eigenvalues at Re=1950 (#68)

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 10.7737861323877  # write at each Floquet period
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -1950.0
