! -----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'
      ! all nekStab
      end
! -----------------------------------------------------------------------
      subroutine nekStab_usrchk
      include 'SIZE'
      include 'TOTAL'
! Select OTD mode via string (recommended over uparam encoding)
      nekstab_mode = 'otd'
! Override defaults (see nekStab_setDefault for full list)
      otd_printStep = 20; call bcast(otd_printStep, isize)
      otd_gsStep = 2; call bcast(otd_gsStep, isize)
      end
! -----------------------------------------------------------------------
      subroutine userf(ix, iy, iz, ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer ix, iy, iz, ieg
      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0
      call nekStab_forcing(ffx, ffy, ffz, ix, iy, iz, ieg)
      end
! -----------------------------------------------------------------------
      subroutine useric(ix, iy, iz, ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer ix, iy, iz, ieg, ie, ijke
      ie = gllel(ieg)
      if (jp == 0) then
! Base flow: plane Poiseuille profile
        ux = 1.0d0 - y**2
        uy = 0.0d0
        uz = 0.0d0
      else
! Perturbations: filled by otd_white_noise or loaded ICs
        ijke = ix + lx1*((iy - 1) + ly1*((iz - 1) + lz1*(ie - 1)))
        ux = vxpic(ijke, jp)
        uy = vypic(ijke, jp)
        uz = vzpic(ijke, jp)
      end if
      end
! -----------------------------------------------------------------------
      subroutine userbc(ix, iy, iz, iside, ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer ix, iy, iz, iside, ieg
! Homogeneous Dirichlet for both base flow walls and perturbations
      ux = 0.0d0
      uy = 0.0d0
      uz = 0.0d0
      end
! -----------------------------------------------------------------------
      subroutine usrdat
      include 'SIZE'
      include 'TOTAL'
!     Scale x (and z in 3D) by pi for periodic domain
      integer n
      n = 8*nelv
      call cmult(xc, 4.0d0*atan(1.0d0), n)
      if (if3d) call cmult(zc, 4.0d0*atan(1.0d0), n)
      end
