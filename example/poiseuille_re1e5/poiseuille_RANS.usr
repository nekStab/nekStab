#include "experimental/rans_komg.f"
! -----------------------------------------------------------------------
!  nekStab adapted RANS Channel flow example
!  Full-channel Poiseuille mesh (32 elements, periodic + wall BCs)
!  k-tau turbulence model at Re = 100,000
! -----------------------------------------------------------------------
      subroutine userchk
      implicit none
      include 'SIZE'
      include 'TOTAL'

      ! all nekStab

      end
! -----------------------------------------------------------------------
      subroutine nekStab_usrchk
      implicit none
      include 'SIZE'
      include 'TOTAL'

      if (istep.eq.0) then !change defaults

         time = 0.0d0
         k_dim = int(uparam(7)) ; call bcast(k_dim,isize)
         schur_tgt = 0 ; call bcast(schur_tgt,isize)
         maxmodes = 10 ; call bcast(maxmodes,isize)
         ifres = .false. ; call bcast(ifres,lsize)
         ifvor = .false. ; call bcast(ifvor,lsize)
         ifvox = .false. ; call bcast(ifvox,lsize)
         ifdyntol = .false. ; call bcast(ifdyntol,lsize)
         iffindiff = .true. ; call bcast(iffindiff,lsize)  ! IMPORTANT: Use finite differences for RANS

      endif

      end
! -----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg
      real rans_mut,rans_mutsk,rans_mutso,rans_turbPrandtl
      real mu_t,Pr_t

      e = gllel(eg)

      Pr_t = rans_turbPrandtl()
      mu_t = rans_mut(ix,iy,iz,e)

      if (ifield.eq.1) then
        udiff = cpfld(ifield,1)+mu_t
        utrans = cpfld(ifield,2)
      elseif (ifield.eq.2) then
        udiff = cpfld(ifield,1)+mu_t*cpfld(ifield,2)
     $       /(Pr_t*cpfld(1,2))
        utrans = cpfld(ifield,2)
      elseif (ifield.eq.3) then
        udiff = cpfld(1,1)+rans_mutsk(ix,iy,iz,e)
        utrans = cpfld(1,2)
      elseif (ifield.eq.4) then
        udiff = cpfld(1,1)+rans_mutso(ix,iy,iz,e)
        utrans = cpfld(1,2)
      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg

      e = gllel(eg)

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      if (ifield.eq.1) then
      call nekStab_forcing(ffx,ffy,ffz,ix,iy,iz,eg) ! velocity
      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg
      real rans_kSrc,rans_omgSrc
      real rans_kDiag,rans_omgDiag

      e = gllel(eg)

      if (ifield.eq.3) then
        qvol = rans_kSrc(ix,iy,iz,e)
        avol = rans_kDiag(ix,iy,iz,e)
      elseif (ifield.eq.4) then
        qvol = rans_omgSrc(ix,iy,iz,e)
        avol = rans_omgDiag(ix,iy,iz,e)
      else
        qvol = 0.0
      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,iside,e,eg

      ! U, TKE, and Omg are all zero on the wall
      ! This applies to both base flow (JP = 0) and perturbations (JP>0)
      ux = 0.0d0
      uy = 0.0d0
      uz = 0.0d0
      temp = 0.0d0

      return
      end
! -----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg

      e = gllel(eg)

      if (JP.eq.0) then         ! velocity/base flow
         ux = 1.0d0 - y**2    ! parabolic profile on [-1,1]
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0

      if (ifield.eq.3) temp = 0.01d0  ! tke
      if (ifield.eq.4) temp = 0.2d0   ! omega/tau
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userqtl ! Set thermal divergence

      ! all userqtl_scig

      return
      end
! -----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer n
      real fact

      ! Scale x-coordinates by pi (reuse Poiseuille mesh [0,2] -> [0,2*pi])
      n = 8*nelv
      fact = 4.0*atan(1.0)
      call cmult(xc,fact,n)

      ! Enforce constant average velocity (mass flux control)
      param(54) = -1
      param(55) = 1.0

      ! Suppress runtime statistics
      param(120) = nsteps

      return
      end
! -----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      implicit none
      include 'SIZE'
      include 'TOTAL'

      real wd(lx1,ly1,lz1,lelv)

      integer ifld_k,ifld_t,m_id,w_id
      real coeffs(30)
      logical ifcoeffs

      ! Setup RANS model, this MUST be done in usrdat2

      ifld_k = 3         !field number for tke, t(1,1,1,1,ifld_k-1)
      ifld_t = 4         !field number for omega/tau, t(1,1,1,1,ifld_t-1)
      ifcoeffs = .false. !set to true to pass custom coefficients

      ! Available models:
      ! m_id = 0 !regularized standard k-omega
      m_id = 4 !standard k-tau

      ! Wall distance function:
      ! w_id = 0 ! user specified
      ! w_id = 1 ! cheap_dist (path to wall, may work better for periodic boundaries)
      w_id = 2 ! distf (coordinate difference, provides smoother function)

      call rans_init(ifld_k,ifld_t,ifcoeffs,coeffs,w_id,wd,m_id)

      return
      end
! -----------------------------------------------------------------------
      subroutine usrdat3()
      implicit none
      include 'SIZE'
      include 'TOTAL'

      return
      end
! -----------------------------------------------------------------------
