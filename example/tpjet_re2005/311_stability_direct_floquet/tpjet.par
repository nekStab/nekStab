[GENERAL]
startFrom = BF_tpjet0.f00001
stopAt = endTime
endTime = 1.666666666667  # 1/St period (St=0.6)

userParam01 = 3.11  # Direct Floquet analysis
userParam05 = 0.600000  # Forcing frequency (St_D)
userParam07 = 100  # k_dim (Krylov subspace dimension)

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no
dealiasing = yes

[PROBLEMTYPE]
axiSymmetry = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-8
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-8
residualProj = yes
density = 1.0
viscosity = -1900.0  # Re=1900 (matches BF_Re1900, above critical Re_c≈1371)
