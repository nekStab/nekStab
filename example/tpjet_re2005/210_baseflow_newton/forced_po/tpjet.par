[GENERAL]
#startFrom = BF_Re1900_tpjet0.f00001
startFrom = BF_tpjet0.f00001
stopAt = endTime
endTime = 1.666666666667

userParam01 = 2.2  # Newton-GMRES forced periodic orbits
userParam05 = 0.600000  #forced frequency (St_D)
userParam07 = 30 # k_dim (GMRES subspace for Newton linear solve)

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime #timeStep
writeInterval = 100.
writeDoublePrecision = no
dealiasing = yes

[PROBLEMTYPE]
axiSymmetry = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-8
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-8
residualProj = yes
density = 1.0
viscosity = -1900.0  # Re=1900 (above critical Re_c≈1371)
