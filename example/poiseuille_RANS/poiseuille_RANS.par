#Nek5000 parameter file
[GENERAL]
stopAt = endTime
endTime = 1.0

# nekStab user parameters
# userParam01 = mode selector (0=dns, 1.1=sfd, 2.0=newton_fp, 3.1=direct, etc.)
# userParam07 = Krylov subspace dimension for Arnoldi
userParam01 = 3.1     # SFD (base flow computation)
#userParam04 = 0.1     # freq SFD
#userParam05 = 0.1     # Gain
userParam07 = 90      # Krylov subspace dimension

dt = 0.01
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5
#extrapolation = OIFS

writeControl = runTime
writeInterval = 50.0
writeDoublePrecision = no

[PROBLEMTYPE]
equation = incompNS
variableProperties = yes
stressFormulation = yes

[MESH]
numberOfBCFields = 1

[VELOCITY]
density = 1.0
viscosity = -1e5
residualTol = 1e-7
residualProj = yes

[PRESSURE]
residualTol = 1e-7
residualProj = yes

[TEMPERATURE]
solver = none

[SCALAR01] # tke
density = 1.0
diffusivity = 1.0
residualTol = 1e-7
residualProj = yes

[SCALAR02] # omega/tau
density = 1.0
diffusivity = 1.0
residualTol = 1e-7
residualProj = yes
