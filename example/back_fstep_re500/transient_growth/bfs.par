[GENERAL]
startFrom = BF_bfs0.f00001
stopAt = endTime
endTime = 50.0  # outer Nek loop horizon (= TG sampling period T per Krylov iter). Coupled knob with k_dim for Arnoldi conditioning: bump one, not both. Keeping T=50 fixed; raising k_dim only for #61.

userParam01 = 3.3  # 0:dns,1:stabilization,3:stability
userParam07 = 128  # k_dim — raised from 64 to break ill-conditioning of the TG Krylov subspace at the original T=50 sampling period (#61)
userParam08 = 5   # sponge lenght left
userParam09 = 10  # sponge lenght right
userParam10 = 2   # sponge strenght

dt = 0.005  # explicit dt; default compute_cfl path returned Infinity here giving nsteps int32 overflow (task #70). 0.005 -> nsteps=10000 over endTime=50.
variableDt = no  # TG matvec requires fixed dt so each forward+adjoint integrates exp(L*T) over the SAME T
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-08
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-08
residualProj = no
density = 1.0
viscosity = -500.0
