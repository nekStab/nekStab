[GENERAL]
startFrom = rstbfs0.f00001
stopAt = endTime
endTime = 0.005

userParam01 = 2   # Newton-GMRES for fixed points
userParam07 = 8 # k_dim (GMRES subspace for Newton linear solve)

dt = 0.006
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 10.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-10
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = no
density = 1.0
viscosity = -500.0
