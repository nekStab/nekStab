[GENERAL]
startFrom = BF_1cyl0.f00001

stopAt = endTime
endTime = 40 # horizon tau of the optimisation; the tau sweep runs copies with other values

userParam01 = 3.3 # transient growth (Krylov-Schur on M^H M; the response output switches to the direct map internally)
userParam03 = 2   # schur_tgt -- target eigenvalues to converge
userParam04 = 0   # maxmodes  (0 = schur_tgt)
userParam06 = 0   # isothermal (no buoyancy coupling)
userParam07 = 50 # k_dim: DELIBERATELY 50 — forces exactly 1 Schur restart so the restart/condensation path is validated here (the exemplar). ~90+ skips the restart. Do NOT bump.
userParam08 = 5   # Sponge left side
userParam09 = 5   # Sponge right side
userParam10 = 1.7 # Sponge strength: absorbs the perturbation packet before the outflow, same in direct and adjoint

dt = 0.005  # explicit: auto-CFL gave dt=0.0101 -> adjoint NaN at t~46; 0.005 matches working back_fstep TG
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -40.0 # Re=40: stable (Re_c ~ 46.6), so the gain is pure non-modal growth (Cantwell & Barkley 2010)
