[GENERAL]
startFrom = BF_seed_1cyl0.f00001

stopAt = endTime
endTime = 1500.0

userParam01 = 1.1  # SFD (Casacuberta formulation -- uparam04<0)
userParam04 = -0.166 # f = omega/2pi in cycles per time unit (St), as for Akervik; NEGATIVE -> Casacuberta
userParam05 = 0.26  # sigma (growth rate of the unstable mode); fixedp.f90 SFD gives cutoff = (sqrt(omega^2 + sigma^2) - sigma)/2 and gain = -(sqrt(omega^2 + sigma^2) + sigma)/2
userParam08 = 0.95 # dynamic velocity tolerance factor
userParam09 = 100  # dynamic tolerance update stride

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 5
extrapolation = OIFS

writeControl = runTime
writeInterval = 1000.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-10
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = no
density = 1.0
viscosity = -100.0
