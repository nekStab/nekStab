[GENERAL]
startFrom = BF_seed_1cyl0.f00001

stopAt = endTime
endTime = 1000.0

userParam01 = 1.1  # SFD (Akervik static)
userParam04 = 0.166 # freq = St of leading mode at Re=100 (Williamson 1996)
userParam05 = 0.26  # gain chi = 2*sigma_r at Re=100 (Barkley & Henderson 1996; sigma_r ~ 0.13)

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1000.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-10
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = no
density = 1.0
viscosity = -100.0
