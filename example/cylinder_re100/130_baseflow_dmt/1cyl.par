[GENERAL]
startFrom = BF_seed_1cyl0.f00001

stopAt = endTime
endTime = 800  # limit that the run does not reach: it stops when the residual falls below userParam15

userParam01 = 1.3  # DMT
userParam11 = 0.7337  # omega_c: angular frequency of the oscillation to damp, the leading mode of 310_stability_direct (sigma 0.1248, omega 0.7337)
userParam12 = 1.0  # beta: width of the damped band
userParam13 = 0.5  # chi: gain of the feedback -chi (u - ubar)
userParam14 = 5.0  # t_start: the feedback starts after this time
userParam15 = 1e-7  # gate: the run stops and writes BF_ when the residual falls below it

dt = 0
variableDt = no  # DMT needs a constant time step
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1000.
writeDoublePrecision = no

dealiasing = yes
#filtering = explicit
#filterWeight = 0.01
#filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-10
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = no
density = 1.0
viscosity = -100.0
