[GENERAL]
startFrom = 0
stopAt = endTime
endTime = 1.0

userParam01 = 4.41  # Sensitivity to steady forcing
userParam07 = 50 # k_dim: DELIBERATELY 50 — forces exactly 1 Schur restart so the restart/condensation path is validated here (the exemplar). ~90+ skips the restart. Do NOT bump.

dt = 0
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -100.0
