#
# DNS phase for snapshot generation (Re=100)
# Runs from the restart file (t = 150, a limit-cycle state) to t = 200, saving every 0.5 time
# units = 100 snapshots 1cyl0.f00001 ... 1cyl0.f00100
#
[GENERAL]
startFrom = rst_1cyl0.f00001

stopAt = endTime
endTime = 200

userParam01 = 0

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 0.5
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -100.0
