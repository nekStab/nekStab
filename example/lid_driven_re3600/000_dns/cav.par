[GENERAL]
# TEMPLATE: set restart source or leave blank for cold start
# startFrom =            # cold start

stopAt = endTime
endTime = 600.0          # the slowest decay has rate 0.016, so 600 leaves the state within 1e-4 of the steady flow

userParam01 = 0          # 0 = DNS (direct numerical simulation)
userParam10 = 1.5   # cavity aspect ratio (.usr rescales Y to [0,uparam10])

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 100.0    # six snapshots; the last one seeds the Newton stage
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -3600.0   # Re=3600
