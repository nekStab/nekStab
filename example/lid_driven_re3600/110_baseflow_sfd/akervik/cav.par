[GENERAL]
# TEMPLATE: SFD classical Akervik (2006); uparam01=1.1; status: scaffold only
# Ref: Akervik et al., Phys. Fluids 18, 068102 (2006)
# Delta chosen from imaginary part of leading unstable eigenvalue (from prior 310 run).
# Example values from cylinder Re=50: userParam04=0.12, userParam05=0.05
startFrom = BF_cav0.f00001

stopAt = endTime
endTime = 400.0          # TEMPLATE: long enough for SFD residual to decay

userParam01 = 1.1        # SFD classical
userParam10 = 1.5   # cavity aspect ratio (.usr rescales Y to [0,uparam10])
userParam04 = 0.12       # TEMPLATE: Delta -- target frequency (omega_i of leading mode, Strouhal)
userParam05 = 0.05       # TEMPLATE: chi -- gain (approx twice the leading growth rate)

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 1000.0
writeDoublePrecision = no

dealiasing = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-9
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-9
residualProj = no
density = 1.0
viscosity = -3600.0   # Re=3600
