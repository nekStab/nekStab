[GENERAL]
startFrom = BFre25t_1cyl0.f00001

stopAt = endTime
endTime = 1.1

userParam01 = 2   # Newton-GMRES for fixed points
userParam06 = 0.2 # Ri: thermal buoyancy coupling
userParam07 = 200 # Krylov size for the Newton solve

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 25.0
writeDoublePrecision = yes

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-8
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-8
residualProj = no
density = 1.0
viscosity = -30.0  # Re = 30

[TEMPERATURE]
solver = helm
residualtol = 1.0E-8
residualproj = yes
writetofieldfile = yes
conductivity = -30.0 # Re*Pr with Pr = 1
rhocp = 1.0
