! -----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      call nekStab

      return
      end
! -----------------------------------------------------------------------
      subroutine nekStab_usrchk
      include 'SIZE'
      include 'TOTAL'

      if (istep.eq.0) then !change defaults

        k_dim = int(uparam(7)) ; call bcast(k_dim,isize)
        schur_tgt = 0 ; call bcast(schur_tgt,isize)
        maxmodes = 2 ; call bcast(maxmodes,isize)
        ifres = .false. ; call bcast(ifres,lsize)
c       This testcase is specifically for Newton with dynamic inner tolerances.
c       Keep `ifdyntol = .true.` here so the folder behavior matches its name:
c       `newton_dyn_temp` = Newton + dynamic tolerances + active temperature.
        ifdyntol = .true. ; call bcast(ifdyntol,lsize)
c       Thermal norm weighting for Newton/Krylov.
c       Cylinder scaling: buoyancy force is Ri * T, so the coupling
c       coefficient is just Ri = uparam(6).
c       Mode 2 uses the automatic energy-based weight with clipping.
c       For the heated-cylinder continuation path, clipping at 10 keeps the
c       scalar contribution visible without over-tightening the first Newton
c       linear solve.  A looser cap of 50 was enough to stall even the
c       previously converged Re=20, Ri=0.2 restart in the first Arnoldi solve.
        thermal_norm_mode = 2
        thermal_buoyancy_coeff = abs(uparam(6))
        thermal_norm_min = 1.0d0
        thermal_norm_max = 10.0d0
        thermal_norm_weight = 1.0d0
        call bcast(thermal_norm_mode,isize)
        call bcast(thermal_buoyancy_coeff,wdsize)
        call bcast(thermal_norm_min,wdsize)
        call bcast(thermal_norm_max,wdsize)
        call bcast(thermal_norm_weight,wdsize)

      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ip, iel
      real rtmp

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

c     Buoyancy forcing: temperature (field 1) couples to y-momentum
c     via Boussinesq approximation.  uparam(6) is the Richardson number.
      if (ifheat .and. uparam(06).gt.0) then
        iel = gllel(ieg)
        ip = ix + nx1*(iy-1+ny1*(iz-1+nz1*(iel-1)))
        if (jp .eq. 0) rtmp = t(ix, iy, iz, iel, 1)
        if (jp .eq. 1) rtmp = tp(ip, 1, 1)
        ffy = rtmp*uparam(06)
      endif

      call nekStab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg)

      return
      end
! -----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity

         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0

         if (x.gt.-1.and.x.lt.1) temp = 1.0d0

      else                      ! perturbation

         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0

      endif

      return
      end
! -----------------------------------------------------------------------
      subroutine usrdat
      return
      end
! -----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc

       if (ifheat) then
c       Temperature BCs live in field slot 2 when IFHEAT is enabled.
c       `ldimt` counts active scalar slots, but does not shift this BC index.
        cbc(:,:,2) = cbc(:,:,1)
        do iel = 1,nelt
         do ifc = 1, 2*ndim
          if (cbc(ifc,iel,1).eq.'W  ')cbc(ifc,iel,2) = 't  '
          if (cbc(ifc,iel,1).eq.'v  ')cbc(ifc,iel,2) = 't  '
         enddo
        enddo
       endif

      return
      end
! -----------------------------------------------------------------------
