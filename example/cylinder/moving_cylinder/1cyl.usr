c-----------------------------------------------------------------------
      subroutine userchk
      use krylov_subspace
      implicit none
      include 'SIZE'
      include 'TOTAL'

      real, dimension(lv,3) :: vort
      real, dimension(lv) :: wo1, wo2
      common /ugrad/ vort, wo1, wo2

      real, dimension(lv) :: csol, lsol, fsol
      real, save :: period
      real :: eps_x, eps_y, glsc3

      nv = nx1*ny1*nz1*nelv

      if(ifusermv) call my_meshv ! Compute our own mesh velocity

      if(istep.eq.0)then

            period = 1.0d0/param(34)
            if (nid.eq.0) write(6,*) 'computed period', period
            ifpo = .true.; ifto = .true. ! Dump vorticity as T

            if((uparam(1).eq.0) .or. (uparam(1).eq.0.1))then

                  time = 0.0d0
                  if(nid.eq.0) write(6,*) 'in DNS mode'
                  fintim = 100.0d0*period ! respect integers of period (HERE YOU SET END TIME)
                  timeio = 10.0d0*period ! respect integers of periods
                  param(10) = fintim
                  param(14) = timeio

            elseif(uparam(1).eq.2.2)then

                  time = 0.0d0
                  if(nid.eq.0) write(6,*) 'in Newton mode'
                  fintim = period ! never change
                  param(10) = fintim
                  ifto = .false.

            elseif(uparam(1).eq.3.11)then

                  time = 0.0d0
                  if(nid.eq.0) write(6,*) 'in Floquet mode'
                  fintim = period ! never change
                  param(10) = fintim
                  ifto = .false.

            endif ! uparam(1)
            call compute_cfl(ctarg, vx, vy, vz, 1.0d0) ! ctarg contains the sum ( ux_i / dx_i )
            if (nid == 0) write (6, *) 'max spatial restriction:', ctarg
            if (nid == 0) write (6, *) 'target Courant:', param(26)
            dt = param(26)/ctarg ! dt given target CFL
            if (nid == 0) write (6, *) 'computed dt:', dt
            dt = period/ceiling(period/dt) ! reducing dt to match period
            if (nid == 0) write (6, *) ' new timeStep dt=', dt
            if (nid == 0) write (6, *) ' dt*period_steps-period=', dt*(period/dt)-period
            param(12) = -dt
            call compute_cfl(ctarg, vx, vy, vz, dt) ! C=sum(ux_i/dx_i)*dt
            if (nid == 0) write (6, *) ' current CFL and target=', ctarg, param(26)

            call bcast(param(10),wdsize); call bcast(fintim,wdsize)
            call bcast(param(12),wdsize); call bcast(dt,wdsize)
            call bcast(param(14),wdsize); call bcast(timeio,wdsize)

            ! if (nid.eq.0)  then
            !       write(6,*) 'ifmvbd,ifusermv,ifmgrid=',ifmvbd,ifusermv,ifmgrid
            !       write(6,*) 'TOLPDF,TOLHDF,TOLREL,TOLABS=',TOLPDF,TOLHDF,TOLREL,TOLABS
            ! endif

      endif ! istep.eq.0

      if(ifoutfld)then
            if(nid.eq.0) write(6,*) ' ifoutfld at time=',time,time/period
            call comp_vort3(vort, wo1, wo2, vx, vy, vz)
            call copy(t, vort, nv) ! Vorticity --> T
      endif

      call nekStab
      if(istep.eq.0 .or. mod(istep,1) == 0) call hpts
      call calculate_torque('dragxy.dat', 4)

      ! this is for the drag at y=0
      if ( time.ge.period .and.(abs(mod(time, period)) < 0.50d0*dt)) then
            if(nid.eq.0) write(6,*) 'in y=0 at time=',time,period,time/period,mod(time, period)
            call calculate_torque2('dragxyC.dat')
      endif

      !! computing eps based on velocity.

      !if(mod(time,period).eq.0)then ! at zero position lag solution at period
      ! call nopcopy(lsol%vx, lsol%vy, lsol%vz, lsol%pr, lsol%t, vx, vy, vz, pr, t)
      !elseif(mod(time,period/2.0d0).eq.0)then ! at period/2
      ! call nopcopy(csol%vx, csol%vy, csol%vz, csol%pr, csol%t, vx, vy, vz, pr, t)

       ! reverse vertical direction on copy ! period/2 reversed
       !call nopcopy(fsol%vx, fsol%vy, fsol%vz, fsol%pr, fsol%t, csol%vx, csol%vy, csol%vz, csol%pr, csol%t)

      !do i=1,n
      !   a(i)=b(i)
      !enddo

        ! do e=1,nelv
        !  do k=1,lz1
        !   do j=1,ly1
        !    do i=1,lx1
        !     fsol%vy(i,j,k,e)=csol%vy(i,j,k,e)
        !    enddo; enddo; enddo; enddo

       !     call k_sub2(csol, fsol)
       !     call outpost2(csol%vx, csol%vy, csol%vz, csol%pr, csol%t, nof, 'eps')
       !     call k_norm(csol, eps)

       !     eps_x = glsc3(csol%vx, bm1s, csol%vx, nv)
       !     eps_y = glsc3(csol%vy, bm1s, csol%vy, nv)
       !     if(nid.eq.0) write(6,*) 'eps_(x,y)=',eps_x,eps_y

      !endif

      !!! add stuff here only valid for uparam(1)=0!!!

      end
c-----------------------------------------------------------------------
      subroutine nekStab_usrchk
      use krylov_subspace
      implicit none
      include 'SIZE'
      include 'TOTAL'

      if(istep.eq.0)then ! only used in Newton or eigenvalue computation

        xLspg = 10.0d0; call bcast(xLspg, wdsize) ! x left
        xRspg = 20.0d0; call bcast(xRspg, wdsize) ! x right
        spng_st = 1.7d0; call bcast(spng_st, wdsize)

        k_dim = int(uparam(7)) ; call bcast(k_dim,isize)
        schur_tgt = 0 ; call bcast(schur_tgt,isize)
        maxmodes = 10 ; call bcast(maxmodes,isize)
        ifdyntol = .true. ; call bcast(ifdyntol,lsize)
        ifstorebase = .true. ; call bcast(ifstorebase,lsize)
        if(uparam(1).gt.0.5)then
            ifvor = .true. ; call bcast(ifvor,lsize)
        else
            ifvor = .false. ; call bcast(ifvor,lsize)
        endif
        ifvox = .false. ; call bcast(ifvox,lsize)
      endif
      if (ifusermv) call my_meshv

      end
c-----------------------------------------------------------------------
