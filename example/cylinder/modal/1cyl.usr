c-----------------------------------------------------------------------
c     Cylinder Re=100 - Modal Analysis Validation
c
c     Expected results:
c       POD: Mode 1-2 should show vortex shedding at St ≈ 0.164-0.167
c       DMD: Peak eigenvalue at f ≈ 0.164-0.167 Hz
c       SPOD: Energy peak at f ≈ 0.164-0.167 Hz
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      call nekStab

      !when in uparam(1)=0 mode (dns) we have hpts at every iteration (meaning at dt)
      call hpts  ! disabled - no history points file

      call nekStab_torque('lift_drag.dat', 10)!here we save every 10

      end
c-----------------------------------------------------------------------
      subroutine nekStab_usrchk
      include 'SIZE'
      include 'TOTAL'

      if (istep .eq. 0) then

c       Sponge zone (suppress reflections at outflow)
        xLspg = 5;   call bcast(xLspg, wdsize)
        xRspg = 10;  call bcast(xRspg, wdsize)
        spng_st = 1.7; call bcast(spng_st, wdsize)

c       ═══════════════════════════════════════════════════════════════
c       MODAL ANALYSIS CONFIGURATION (Mode 6)
c       ═══════════════════════════════════════════════════════════════

c       Snapshot source (prefix of DNS output files)
c       Empty prefix means use SESSION name directly (1cyl0.f*)
        modal_prefix = '   '
        call bcast(modal_prefix, 3)

c       Number of snapshots to load
c       writeInterval=0.5, endTime=50 -> 100 snapshots
        modal_nsnap = 100
        call bcast(modal_nsnap, isize)

c       Time between snapshots (must match writeInterval)
        modal_dt = 0.5d0
        call bcast(modal_dt, wdsize)

c       Number of modes to save
        modal_nsave = 1
        call bcast(modal_nsave, isize)

c       Which methods to run
        ifpod = .true.;  call bcast(ifpod, lsize)
        ifdmd = .true.;  call bcast(ifdmd, lsize)
        ifspod = .true.; call bcast(ifspod, lsize)

c       Window normalization: .true. = PySPOD compatible (amplitude)
c                            .false. = Parseval (energy-preserving)
        ifwinamp = .true.; call bcast(ifwinamp, lsize)

c       DMD: fixed rank for better dynamics capture
c       (auto-rank 0 gives r=3, missing oscillations)
        dmd_rank = 20
        call bcast(dmd_rank, isize)

c       POD-FFT/SPOD: FFT block size and overlap
c       nfft=64 with dt=0.5 gives df = 1/(64*0.5) = 0.03125 St
c       With 100 snaps, noverlap=48: nblk = (100-64)/(64-48)+1 = 3 blocks
        spod_nfft = 64
        call bcast(spod_nfft, isize)
        spod_noverlap = 48
        call bcast(spod_noverlap, isize)

c       ═══════════════════════════════════════════════════════════════
c       Stability analysis settings (if running Mode 3)
c       ═══════════════════════════════════════════════════════════════
        k_dim = int(uparam(7)); call bcast(k_dim, isize)
        schur_tgt = 0;  call bcast(schur_tgt, isize)
        maxmodes = 10;  call bcast(maxmodes, isize)
        ifres = .false.; call bcast(ifres, lsize)
        ifvor = .false.; call bcast(ifvor, lsize)
        ifvox = .false.; call bcast(ifvox, lsize)

      endif
      end
c-----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      call nekStab_forcing(ffx, ffy, ffz, ix, iy, iz, ieg)

      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP .eq. 0) then       ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP .eq. 0) then       ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0

         if (x .gt. -1 .and. x .lt. 1) temp = 1.0d0

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      call nekStab_define_obj

      end
c-----------------------------------------------------------------------
      subroutine usrdat
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      end
c-----------------------------------------------------------------------
