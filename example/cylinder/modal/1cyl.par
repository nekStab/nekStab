#
# Cylinder Re=100 - Modal Analysis Test Case
#
# Phase 1: Generate snapshots (uparam01 = 0)
#   - Runs DNS from t=150 (post-washout), outputs every 0.5 time units
#   - 100 snapshots from t=150 to t=200 (clean, transient-free)
#
# Phase 2: Modal analysis (uparam01 = 6)
#   - Reads DNS snapshots, computes POD/DMD/SPOD
#   - Expected: St ≈ 0.164-0.167 (f ≈ 0.164-0.167 Hz)
#

[GENERAL]
startFrom = rst_1cyl0.f00001

stopAt = endTime
endTime = 2000

userParam01 = 0

dt = 0
variableDt = yes
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 0.5
writeDoublePrecision = no

dealiasing = yes
filtering = explicit
filterWeight = 0.01
filterCutoffRatio = 0.84

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-06
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-08
residualProj = no
density = 1.0
viscosity = -100.0
