      !---------------------------------------------------------------------
      subroutine userchk
         implicit none
         include 'SIZE'
         include 'TOTAL'
         call nekStab
         call hpts
      end
      !---------------------------------------------------------------------
      subroutine nekStab_usrchk
         implicit none
         include 'SIZE'
         include 'TOTAL'
         if (istep == 0) then !change defaults
            k_dim = int(uparam(7)); call bcast(k_dim, isize)
            schur_tgt = 2; call bcast(schur_tgt, isize)
            maxmodes = 2; call bcast(maxmodes, isize)
            ifres = .false.; call bcast(ifres, lsize)
            ifvor = .false.; call bcast(ifvor, lsize)
            ifvox = .false.; call bcast(ifvox, lsize)
            glob_skip = 1000; call bcast(glob_skip, isize)
      
            otd_printStep = 10; call bcast(otd_printStep, isize)
            otd_gsStep = 10; call bcast(otd_gsStep, isize)
            !otd_FTLEPeriod = 5.98197034139; call bcast(otd_FTLEPeriod, wdsize)
            otd_FTLEPeriod = 0.0d0; call bcast(otd_FTLEPeriod, wdsize)
            otd_computeFTLE = .true.; call bcast(otd_computeFTLE, lsize)
      
         end if
      end
      !---------------------------------------------------------------------S
      subroutine userf(ix, iy, iz, ieg)
         implicit none
         include 'SIZE'
         include 'TOTAL'
         include 'NEKUSE'
         integer ix, iy, iz, ieg
         ffx = 0.0d0
         ffy = 0.0d0
         ffz = 0.0d0
         call nekStab_forcing(ffx, ffy, ffz, ix, iy, iz, ieg)
      end
      !---------------------------------------------------------------------
      subroutine useric(ix, iy, iz, ieg)
         implicit none
         include 'SIZE'
         include 'TOTAL'
         include 'NEKUSE'
         integer ix, iy, iz, ieg, ie, ijke
         ie = gllel(ieg)
         if (JP == 0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp = 0.0d0
            ubic(ix, iy, iz, ie) = ux
            vbic(ix, iy, iz, ie) = uy
            wbic(ix, iy, iz, ie) = uz
         else ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp = 0.0d0
            ijke = ix + lx1*((iy - 1) + ly1*((iz - 1) + lz1*(ie - 1)))
            ux = vxpic(ijke, jp)
            uy = vypic(ijke, jp)
            uz = vzpic(ijke, jp)
         end if
      end
      !---------------------------------------------------------------------
      subroutine userbc(ix, iy, iz, iside, ieg)
         include 'SIZE'
         include 'TOTAL'
         include 'NEKUSE'
         integer e
         if (JP == 0) then ! velocity
            e = gllel(ieg)
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp = 0.0d0
            if (x > -1 .and. x < 1) temp = 1.0d0 !cylinder with T
         else ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp = 0.0d0
         end if
      end
      !---------------------------------------------------------------------
      subroutine usrdat2
         include 'SIZE'
         include 'TOTAL'
         integer iel, ifc
      
      !this mesh was generatd with genbox
      !with only BCs for velicity
      !here we chenge outflow to dirichlet if adjoint
      !and initilize BCs for scalar field
      
         if (uparam(1) == 3.2) then !if adjoint, change BCs
         do iel = 1, nelt
         do ifc = 1, 2*ndim
            if (cbc(ifc, iel, 1) == 'O  ') cbc(ifc, iel, 1) = 'v  '
         end do
         end do
         end if
      
         if (ifheat) then
            cbc(:, :, 2) = cbc(:, :, 1)
            do iel = 1, nelt
            do ifc = 1, 2*ndim
               if (cbc(ifc, iel, 1) == 'W  ') cbc(ifc, iel, 2) = 't  '
               if (cbc(ifc, iel, 1) == 'v  ') cbc(ifc, iel, 2) = 't  '
            end do
            end do
         end if
      end
