! -----------------------------------------------------------------------
      subroutine userchk
      use krylov_subspace
      use nekstab_io, only: k_load
      use nekstab_diagnostics, only: smooth_field
      implicit none
      include 'SIZE'
      include 'TOTAL'

      type(krylov_vector), save :: Re, Im
      type(krylov_vector) :: Re_sin, Im_cos
      character(len = 80) :: filename

      integer, parameter :: nxyz = lx1*ly1*lz1
      real :: eps = 0.0d0
      real, save :: final_eps = 1.0d0
      real, save :: final_eps_p = 1.0d0
      real gije(lx1*ly1*lz1, ldim, ldim)
      real ss(ldim, ldim), oo(ldim, ldim)
      real omega_field(lx1, ly1, lz1, lelv)
      real omega_field_p(lx1, ly1, lz1, lelv)
      real norm_a(lx1, ly1, lz1, lelv)
      real norm_b(lx1, ly1, lz1, lelv)
      real eps_field(lx1, ly1, lz1, lelv), glmax, glmin
      real omega_field_max, omega_field_min
      real, save :: omega
      integer ie, l, i, j, iter, number_of_files

      call nekStab

      call hpts
      call nekStab_torque('lift_drag.dat',1)

      if (istep.eq.0) then
            call k_load(Re, 'dRe')
            call k_load(Im, 'dIm')
            call load_fld('BF_' // trim(SESSION) // '0.f00001')

            if (nid.eq.0) then
                  open(unit = 10, file = 'Spectre_NSd_conv.dat', status = 'old', action = 'read')
                  read(10, '(2E15.7)') omega_field_min, omega ! omega_field_min is recycle as dummy
                  close(10)
                  omega = abs(omega) ! if omega is read as negative
                  write(6,*) 'Read omega value from file: ', omega
            endif
            call bcast(omega, wdsize) ! broadcast omega value

            time = 0.0d0 ! reset time
            fintim = 8.0d0 * atan(1.0d0) / omega ! period of leading mode
            number_of_files = 64
            timeio = fintim / number_of_files
            fintim = fintim + timeio
            if (nid.eq.0) then
                  write(6,*) 'fintim (period of leading mode) set to: ', fintim
                  write(6,*) 'timeio set to: ', timeio
                  write(6,*) 'time reset to: ', time

                  write(6,*) 'Number of files: ', number_of_files
                  write(6,*) 'sanity check: ', number_of_files*timeio,'==',fintim
            endif
      endif

      if (ifoutfld) then
            do ie = 1, nelv
            call comp_gije(gije, vx(1, 1, 1, ie), vy(1, 1, 1, ie), vz(1, 1, 1, ie), ie)
            do l = 1, nxyz
            do j = 1, ldim
                  do i = 1, ldim
                        ss(i, j) = 0.50d0 * (gije(l, i, j) + gije(l, j, i))
                        oo(i, j) = 0.50d0 * (gije(l, i, j) - gije(l, j, i))
                  end do
            end do
            norm_a(l, 1, 1, ie) = (norm2(ss)**2)**2
            norm_b(l, 1, 1, ie) = (norm2(oo)**2)**2
            eps_field = norm_b(l, 1, 1, ie) - norm_a(l, 1, 1, ie)
            end do
            end do

            if (final_eps >= 1.0d0) then

                  eps = glmax(eps_field, nv) * 0.001d0
                  if (nid.eq.0) write(6,*) 'Initial eps = ', eps

                  do iter = 1, 20
                        do ie = 1, nelv
                        do l = 1, nxyz
                              omega_field(l, 1, 1, ie) = norm_b(l, 1, 1, ie) / (norm_a(l, 1, 1, ie) + norm_b(l, 1, 1, ie) + eps)
                        end do
                        end do

                        omega_field_max = glmax(omega_field, nv)
                        if (abs(omega_field_max - 1.0d0) < 1.0e-8) exit

                        omega_field_min = glmin(omega_field, nv)
                        if (nid.eq.0) write(6,*) 'Iteration ', iter, ': omega_field_max = ', omega_field_max, ', omega_field_min = ', omega_field_min

                        if (omega_field_max > 1.0d0) then
                              if (nid.eq.0) write(6,*) 'Increasing eps: ', eps
                              eps = eps * 2.0d0
                        else if (omega_field_max < 1.0d0) then
                              if (nid.eq.0) write(6,*) 'Decreasing eps: ', eps
                              eps = eps * 0.50d0
                        end if


                        final_eps = eps
                        if (nid.eq.0) write(6,*) 'Final eps value: ', final_eps
                        call bcast(final_eps, wdsize)
                  end do ! iter
            endif ! final_eps

            do ie = 1, nelv; do l = 1, nxyz
            omega_field(l, 1, 1, ie) = norm_b(l, 1, 1, ie) / (norm_a(l, 1, 1, ie) + norm_b(l, 1, 1, ie) + final_eps)
            end do; end do

            ! !non filtered (to check)
            ! call outpost(omega_field, Re_sin%vy, Re_sin%vz, Re_sin%pr, Re_sin%t, 'omR')

            call smooth_field(omega_field) ! filtering put the field out of bounds [0,1]

            do ie = 1, nelv; do l = 1, nxyz ! clip the field to [0,1] after filtering (tested on cylinder, better results)
                  omega_field(l, 1, 1, ie) = min(1.0d0, max(0.0d0, omega_field(l, 1, 1, ie)))
            end do; end do

            ! Now we do it on the perturbation field

            call k_copy(Re_sin, Re)
            call k_cmult(Re_sin, cos(omega * time))
            call k_copy(Im_cos, Im)
            call k_cmult(Im_cos, -sin(omega * time))
            call k_add2(Re_sin, Im_cos)
            call opcopy(ubase, vbase, wbase, Re_sin%vx, Re_sin%vy, Re_sin%vz) ! send to base as they are in (:,:,:,:)

            do ie = 1, nelv
            call comp_gije(gije, ubase(1, 1, 1, ie), vbase(1, 1, 1, ie), wbase(1, 1, 1, ie), ie)
            do l = 1, nxyz
            do j = 1, ldim
                  do i = 1, ldim
                        ss(i, j) = 0.50d0 * (gije(l, i, j) + gije(l, j, i))
                        oo(i, j) = 0.50d0 * (gije(l, i, j) - gije(l, j, i))
                  end do
            end do
            norm_a(l, 1, 1, ie) = (norm2(ss)**2)**2
            norm_b(l, 1, 1, ie) = (norm2(oo)**2)**2
            eps_field = norm_b(l, 1, 1, ie) - norm_a(l, 1, 1, ie)
            end do
            end do

            if (final_eps_p >= 1.0d0) then

                  eps = glmax(eps_field, nv) * 0.001d0
                  if (nid.eq.0) write(6,*) 'Initial eps = ', eps

                  do iter = 1, 20
                        do ie = 1, nelv
                        do l = 1, nxyz
                              omega_field_p(l, 1, 1, ie) = norm_b(l, 1, 1, ie) / (norm_a(l, 1, 1, ie) + norm_b(l, 1, 1, ie) + eps)
                        end do
                        end do

                        omega_field_max = glmax(omega_field_p, nv)
                        if (abs(omega_field_max - 1.0d0) < 1.0e-8) exit

                        omega_field_min = glmin(omega_field_p, nv)
                        if (nid.eq.0) write(6,*) 'Iteration ', iter, ': omega_field_max = ', omega_field_max, ', omega_field_min = ', omega_field_min

                        if (omega_field_max > 1.0d0) then
                              if (nid.eq.0) write(6,*) 'Increasing eps: ', eps
                              eps = eps * 10.0d0
                        else if (omega_field_max < 1.0d0) then
                              if (nid.eq.0) write(6,*) 'Decreasing eps: ', eps
                              eps = eps * 0.10d0
                        end if

                        final_eps_p = eps
                        if (nid.eq.0) write(6,*) 'Final eps value: ', final_eps_p
                        call bcast(final_eps_p, wdsize)
                  end do ! iter
            endif ! final_eps_p

            do ie = 1, nelv; do l = 1, nxyz
            omega_field_p(l, 1, 1, ie) = norm_b(l, 1, 1, ie) / (norm_a(l, 1, 1, ie) + norm_b(l, 1, 1, ie) + final_eps_p)
            end do; end do

            ! note : ifto and ifpo are set in .par
            call copy(t(1, 1, 1, 1, 2), omega_field, nv); ifpsco(1) = .true.
            call copy(t(1, 1, 1, 1, 3), Re_sin%vx, nv); ifpsco(2) = .true.
            call copy(t(1, 1, 1, 1, 4), Re_sin%vy, nv); ifpsco(3) = .true.

            if (if3d) then
            call copy(t(1, 1, 1, 1, 5), Re_sin%vz, nv); ifpsco(4) = .true.
            else
                                                        ifpsco(4) = .false.
            endif

            ! omega_R smoothed and clipped
            call smooth_field(omega_field_p) ! filtering put the field out of bounds [0,1]
            do ie = 1, nelv; do l = 1, nxyz ! clip the field to [0,1] after filtering (tested on cylinder, better results)
                  omega_field_p(l, 1, 1, ie) = min(1.0d0, max(0.0d0, omega_field_p(l, 1, 1, ie)))
            end do; end do
            call copy(t(1, 1, 1, 1, 6), omega_field_p, nv); ifpsco(5) = .true.


      endif
      end subroutine userchk
! -----------------------------------------------------------------------
      subroutine nekStab_usrchk
      include 'SIZE'
      include 'TOTAL'

      if (istep.eq.0) then !change defaults

        ! xLspg = uparam(8); call bcast(xLspg , wdsize)
        ! xRspg = uparam(9); call bcast(xRspg , wdsize)
        ! spng_st = uparam(10);  call bcast(spng_st, wdsize)

        k_dim = int(uparam(7)) ; call bcast(k_dim,isize)
        schur_tgt = 2 ; call bcast(schur_tgt,isize)
        maxmodes = 2 ; call bcast(maxmodes,isize)
        ifres = .false. ; call bcast(ifres,lsize)
        ifvor = .false. ; call bcast(ifvor,lsize)
        ifvox = .false. ; call bcast(ifvox,lsize)
        ifdyntol = .true. ; call bcast(ifdyntol,lsize)
        glob_skip = 100 ; call bcast(glob_skip,isize)

      endif
      end
! -----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ffx = 0.0d0
      ffy = 0.0d0
      ! if(ifto)ffy = temp*0.15d0 !coupling the scalar field
      ffz = 0.0d0
      call nekStab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg)
      end
! -----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif
      end
! -----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e
      if (JP.eq.0) then         ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
         if (x.gt.-1.and.x.lt.1)temp = 1.0d0 !cylinder with T
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif
      end
! -----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc

      ! this mesh was generatd with genbox
      ! with only BCs for velicity
      ! here we chenge outflow to dirichlet if adjoint
      ! and initilize BCs for scalar field

      if (uparam(1)==3.2) then !if adjoint, change BCs
      do iel = 1,nelt
      do ifc = 1, 2*ndim
        if (cbc(ifc,iel,1).eq.'O  ')cbc(ifc,iel,1) = 'v  '
      enddo
      enddo
      endif

      if (ifheat) then
      cbc(:,:,2) = cbc(:,:,1)
      do iel = 1,nelt
       do ifc = 1, 2*ndim
        if (cbc(ifc,iel,1).eq.'W  ')cbc(ifc,iel,2) = 't  '
        if (cbc(ifc,iel,1).eq.'v  ')cbc(ifc,iel,2) = 't  '
      enddo
      enddo
      endif


      call nekStab_define_obj
      end
