! -----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'
      call nekStab
      end
! -----------------------------------------------------------------------
      subroutine nekStab_usrchk
      include 'SIZE'
      include 'TOTAL'

      if (istep.eq.0) then !change defaults

c       Keep userParam01 = 3.0 in the input file as requested, but force the
c       human-readable mode string so this checkout resolves the case to the
c       direct eigensolver path.  The string mode has higher priority than the
c       legacy floating-point decoder.
        nekstab_mode = 'direct'
        call bcast(nekstab_mode,32*csize)

        ! xLspg = uparam(8); call bcast(xLspg , wdsize)
        ! xRspg = uparam(9); call bcast(xRspg , wdsize)
        ! spng_st = uparam(10);  call bcast(spng_st, wdsize)

        k_dim = int(uparam(7)) ; call bcast(k_dim,isize)
        schur_tgt = int(uparam(3))
        if (schur_tgt.le.0) schur_tgt = 2
        call bcast(schur_tgt,isize)
        maxmodes = int(uparam(4))
        if (maxmodes.le.0) maxmodes = schur_tgt
        call bcast(maxmodes,isize)
        ifres = .false. ; call bcast(ifres,lsize)
        ifvor = .false. ; call bcast(ifvor,lsize)
        ifvox = .false. ; call bcast(ifvox,lsize)
c       Cylinder thermal eigen-analysis uses the same Ri*T buoyancy model
c       as the thermal base-flow solve, so reuse the same automatic norm rule.
c       Keep the same tighter clip used in the base-flow case so the scalar
c       block stays comparable across the full cylinder thermal pipeline.
        thermal_norm_mode = 2
        thermal_buoyancy_coeff = abs(uparam(6))
        thermal_norm_min = 1.0d0
        thermal_norm_max = 10.0d0
        thermal_norm_weight = 1.0d0
        call bcast(thermal_norm_mode,isize)
        call bcast(thermal_buoyancy_coeff,wdsize)
        call bcast(thermal_norm_min,wdsize)
        call bcast(thermal_norm_max,wdsize)
        call bcast(thermal_norm_weight,wdsize)

      endif
      end
! -----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ip, iel
      real rtmp

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

c     Buoyancy forcing: temperature (field 1) couples to y-momentum
c     via Boussinesq approximation.  uparam(6) is the Richardson number.
      if (ifheat .and. uparam(06).gt.0) then
         iel = gllel(ieg)
         ip = ix + nx1*(iy-1+ny1*(iz-1+nz1*(iel-1)))
         if (jp .eq. 0) rtmp = t(ix, iy, iz, iel, 1)
         if (jp .eq. 1) rtmp = tp(ip, 1, 1)
         ffy = rtmp*uparam(06)
      endif

      call nekStab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg)

      end
! -----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif
      end
! -----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0

         if (x.gt.-1.and.x.lt.1)temp = 1.0d0 !cylinder with T

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif
      end
! -----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc

      ! this mesh was generatd with genbox
      ! with only BCs for velicity
      ! here we chenge outflow to dirichlet if adjoint
      ! and initilize BCs for scalar field

      if (uparam(1)==3.2) then !if adjoint, change BCs
      do iel = 1,nelt
      do ifc = 1, 2*ndim
        if (cbc(ifc,iel,1).eq.'O  ')cbc(ifc,iel,1) = 'v  '
      enddo
      enddo
      endif

      if (ifheat) then
      cbc(:,:,2) = cbc(:,:,1)
      do iel = 1,nelt
       do ifc = 1, 2*ndim
        if (cbc(ifc,iel,1).eq.'W  ')cbc(ifc,iel,2) = 't  '
        if (cbc(ifc,iel,1).eq.'v  ')cbc(ifc,iel,2) = 't  '
      enddo
      enddo
      endif
      end
