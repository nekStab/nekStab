[GENERAL]
stopat = endTime
endTime = 5000.0

dt = 0
variableDT = yes
targetCFL = 0.5
timestepper = bdf3
writecontrol = runTime
writeinterval = 2500

[PROBLEMTYPE]
equation = incompLinNS
numberOfPerturbations = 3
solveBaseflow = no

[PRESSURE]
residualtol = 1e-8
residualproj = yes

[VELOCITY]
residualtol = 1e-8
residualproj = yes
density = 1
viscosity = -5000.0
