[GENERAL]
stopat = endTime
endTime = 100.0

dt = 0
variableDT = yes
targetCFL = 0.4
timestepper = bdf2
writecontrol = runTime
writeinterval = 5000  

[PROBLEMTYPE]
equation = incompLinNS
numberOfPerturbations = 2
solveBaseflow = no
variableProperties = no

[PRESSURE]
residualtol = 1e-8
residualproj = yes

[VELOCITY]
residualtol = 1e-8
residualproj = yes
density = 1
viscosity = -5000.0