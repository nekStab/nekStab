
# nekStab build rules — module dependency chain
# All .f90 files compiled with fixed-format flags (FL2) except fourier*.f90

# Free-form flags: replace -fixed/-ffixed-form with -free/-ffree-form
# Intel: -fixed -> -free; GCC: -ffixed-form -> -ffree-form
FL2_FREE = $(subst -fixed,-free,$(subst -ffixed-form,-ffree-form,$(FL2)))

NS = $(NEKSTAB_SOURCE_ROOT)/src
O  = $(OBJDIR)

# ─────────────────────────────────────────────────────────────────────
# Level 0: Leaf modules (no nekStab module dependencies)
# ─────────────────────────────────────────────────────────────────────
$(O)/nek_vectors.o:       $(NS)/nek_vectors.f90       ;$(FC) -c $(FL2) $< -o $@
$(O)/argsort.o:           $(NS)/argsort.f90           ;$(FC) -c $(FL2) $< -o $@
$(O)/lapack_wrapper.o:    $(NS)/lapack_wrapper.f90    ;$(FC) -c $(FL2) $< -o $@
$(O)/vortex.o:            $(NS)/vortex.f90            ;$(FC) -c $(FL2) $< -o $@
$(O)/torque.o:            $(NS)/torque.f90            ;$(FC) -c $(FL2) $< -o $@
$(O)/mode_config.o:       $(NS)/mode_config.f90       ;$(FC) -c $(FL2) $< -o $@
$(O)/fourier_fftw.o:      $(NS)/fourier_fftw.f90      ;$(FC) -c $(FL2_FREE) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 1: krylov_subspace (depends on nekstab_vectors)
# ─────────────────────────────────────────────────────────────────────
$(O)/krylov_subspace.o:   $(NS)/krylov_subspace.f90   $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 1.5: Batch inner products (depends on krylov_subspace only)
# ─────────────────────────────────────────────────────────────────────
$(O)/krylov_inner_products.o: $(NS)/krylov_inner_products.f90 $(O)/krylov_subspace.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 2: Modules that depend on krylov_subspace + Level 0
# ─────────────────────────────────────────────────────────────────────
$(O)/fourier.o:           $(NS)/fourier.f90           $(O)/krylov_subspace.o $(O)/fourier_fftw.o ;$(FC) -c $(FL2_FREE) $< -o $@
$(O)/IO.o:                $(NS)/IO.f90                $(O)/krylov_subspace.o $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@
$(O)/matvec.o:            $(NS)/matvec.f90            $(O)/krylov_subspace.o $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@
$(O)/noise.o:             $(NS)/noise.f90             $(O)/krylov_subspace.o ;$(FC) -c $(FL2) $< -o $@
$(O)/probes.o:            $(NS)/probes.f90            $(O)/krylov_subspace.o ;$(FC) -c $(FL2) $< -o $@
$(O)/statistics.o:        $(NS)/statistics.f90        $(O)/krylov_subspace.o ;$(FC) -c $(FL2) $< -o $@
$(O)/forcing.o:           $(NS)/forcing.f90           $(O)/krylov_subspace.o $(O)/otd.o ;$(FC) -c $(FL2) $< -o $@
$(O)/diagnostics.o:       $(NS)/diagnostics.f90       $(O)/krylov_subspace.o $(O)/vortex.o ;$(FC) -c $(FL2) $< -o $@
$(O)/otd.o:               $(NS)/otd.f90               $(O)/krylov_subspace.o $(O)/IO.o $(O)/noise.o ;$(FC) -c $(FL2) $< -o $@
$(O)/fst.o:               $(NS)/fst.f90               $(O)/krylov_subspace.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 3: krylov_decomposition (depends on matvec, lapack, IO)
# ─────────────────────────────────────────────────────────────────────
$(O)/krylov_decomposition.o: $(NS)/krylov_decomposition.f90 $(O)/krylov_subspace.o $(O)/krylov_inner_products.o $(O)/matvec.o $(O)/lapack_wrapper.o $(O)/IO.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 4: eigensolvers (depends on krylov_decomposition + many Level 0)
# ─────────────────────────────────────────────────────────────────────
$(O)/eigensolvers.o:      $(NS)/eigensolvers.f90      $(O)/krylov_subspace.o $(O)/krylov_decomposition.o $(O)/lapack_wrapper.o $(O)/argsort.o $(O)/nek_vectors.o $(O)/matvec.o $(O)/IO.o $(O)/diagnostics.o $(O)/noise.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Level 5: Modules that depend on eigensolvers
# ─────────────────────────────────────────────────────────────────────
$(O)/fixedp.o:            $(NS)/fixedp.f90            $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/diagnostics.o $(O)/newton_krylov.o ;$(FC) -c $(FL2) $< -o $@
$(O)/sensitivity.o:       $(NS)/sensitivity.f90       $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/IO.o $(O)/eigensolvers.o $(O)/matvec.o $(O)/diagnostics.o $(O)/newton_krylov.o $(O)/energy_budget.o $(O)/torque.o ;$(FC) -c $(FL2) $< -o $@
$(O)/newton_krylov.o:     $(NS)/newton_krylov.f90     $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/matvec.o $(O)/krylov_decomposition.o $(O)/lapack_wrapper.o $(O)/diagnostics.o ;$(FC) -c $(FL2) $< -o $@
$(O)/energy_budget.o:     $(NS)/energy_budget.f90     $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/IO.o $(O)/matvec.o $(O)/eigensolvers.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Modal analysis modules
# ─────────────────────────────────────────────────────────────────────
$(O)/modal_pod.o:         $(NS)/modal_pod.f90         $(O)/krylov_subspace.o $(O)/krylov_inner_products.o $(O)/fourier.o $(O)/lapack_wrapper.o $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@
$(O)/modal_dmd.o:         $(NS)/modal_dmd.f90         $(O)/krylov_subspace.o $(O)/krylov_inner_products.o $(O)/lapack_wrapper.o $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@
$(O)/modal_spod.o:        $(NS)/modal_spod.f90        $(O)/krylov_subspace.o $(O)/krylov_inner_products.o $(O)/fourier.o $(O)/modal_pod.o $(O)/lapack_wrapper.o $(O)/nek_vectors.o ;$(FC) -c $(FL2) $< -o $@
$(O)/modal_spod_streaming.o: $(NS)/modal_spod_streaming.f90 $(O)/krylov_subspace.o $(O)/krylov_inner_products.o $(O)/modal_pod.o $(O)/modal_spod.o $(O)/lapack_wrapper.o ;$(FC) -c $(FL2) $< -o $@
$(O)/modal_analysis.o:    $(NS)/modal_analysis.f90    $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/IO.o $(O)/fourier.o $(O)/modal_pod.o $(O)/modal_dmd.o $(O)/modal_spod.o $(O)/modal_spod_streaming.o ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Main entry points (bare subroutines, uses all modules)
# ─────────────────────────────────────────────────────────────────────
$(O)/main.o: $(NS)/main.f90 \
   $(O)/krylov_subspace.o $(O)/nek_vectors.o $(O)/mode_config.o \
   $(O)/eigensolvers.o $(O)/krylov_decomposition.o $(O)/lapack_wrapper.o \
   $(O)/sensitivity.o $(O)/newton_krylov.o $(O)/fixedp.o \
   $(O)/otd.o $(O)/fst.o $(O)/forcing.o $(O)/diagnostics.o \
   $(O)/energy_budget.o $(O)/IO.o $(O)/modal_analysis.o \
   $(O)/statistics.o $(O)/noise.o $(O)/probes.o $(O)/torque.o \
   $(O)/vortex.o $(O)/matvec.o \
   ;$(FC) -c $(FL2) $< -o $@

$(O)/usr_wrappers.o: $(NS)/usr_wrappers.f90 $(O)/torque.o $(O)/forcing.o \
   ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# .usr compilation needs .mod files from nekStab modules.
# GNU Make merges prerequisites from multiple rules for the same target.
# ─────────────────────────────────────────────────────────────────────
$(USRF): $(O)/krylov_subspace.o $(O)/otd.o $(O)/fst.o
