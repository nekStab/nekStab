
# all nekStab files are in .f90 (format for )free format source code

# Free-form flags: replace -fixed/-ffixed-form with -free/-ffree-form
# Intel: -fixed -> -free; GCC: -ffixed-form -> -ffree-form
FL2_FREE = $(subst -fixed,-free,$(subst -ffixed-form,-ffree-form,$(FL2)))

# ─────────────────────────────────────────────────────────────────────
# Core modules (no dependencies)
# ─────────────────────────────────────────────────────────────────────
$(OBJDIR)/krylov_subspace.o:      $(NEKSTAB_SOURCE_ROOT)/src/krylov_subspace.f90      ;$(FC) -c $(FL2) $< -o $@
$(OBJDIR)/argsort.o:              $(NEKSTAB_SOURCE_ROOT)/src/argsort.f90              ;$(FC) -c $(FL2) $< -o $@

# ─────────────────────────────────────────────────────────────────────
# Fourier modules
# ─────────────────────────────────────────────────────────────────────
$(OBJDIR)/fourier_fftw.o:         $(NEKSTAB_SOURCE_ROOT)/src/fourier_fftw.f90         ;$(FC) -c $(FL2_FREE) $< -o $@
$(OBJDIR)/fourier.o:              $(NEKSTAB_SOURCE_ROOT)/src/fourier.f90              $(OBJDIR)/krylov_subspace.o $(OBJDIR)/fourier_fftw.o ;$(FC) -c $(FL2_FREE) $< -o $@

