#!/bin/bash

# Get the directory where the script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Determine the OS type for compatible sed in-place editing
if [[ "$(uname)" == "Darwin" ]]; then
    SED_INPLACE=('sed' '-i' '')
else
    SED_INPLACE=('sed' '-i')
fi

# Function to check if file is Fortran source
is_fortran_file() {
    local file="$1"
    # Check if file has .f90 extension or is a known include file
    if [[ "$file" == *.f90 ]] || \
       [[ "$file" == *"NEKSTAB"* ]]; then
        return 0
    fi
    return 1
}

# Function to process a single file
process_file() {
    local file="$1"
    local temp_file="${file}.tmp"
    echo "Processing file: $file"

    # Make a backup of the original file
    cp "$file" "$temp_file"

    # Convert tabs to spaces (4 spaces per tab)
    expand -t 4 "$temp_file" > "${temp_file}.expanded"
    mv "${temp_file}.expanded" "$temp_file"

    # Remove trailing spaces and tabs
    "${SED_INPLACE[@]}" 's/[[:space:]]*$//' "$temp_file"

    # Remove leading spaces and tabs
    "${SED_INPLACE[@]}" 's/^[[:space:]]*//' "$temp_file"

    # Run fprettify with fixed settings
    # Options:
    # --case 1 1 1 1          : Lowercase for keywords, procedures, operators, constants
    # --enable-decl          : Enable whitespace formatting for declarations
    # --enable-replacements  : Replace relational operators
    # --c-relations         : Use C-style relational operators
    # --whitespace 2        : Preset for whitespace (operators, print/read, plus/minus)
    # --strict-indent       : Strictly impose indentation for nested loops
    # --strip-comments      : Strip whitespace before comments
    # --line-length 132     : Set maximum line length
    FPRETTIFY_CONFIG_FILE="/dev/null" fprettify "$temp_file" \
        --case 1 1 1 1 \
        --enable-decl \
        --enable-replacements \
        --c-relations \
        --whitespace 2 \
        --strict-indent \
        --strip-comments \
        --line-length 132

    # Add 6 leading spaces to all lines
    "${SED_INPLACE[@]}" 's/^/      /' "$temp_file"

    # Fix the number of spaces before $ to exactly 5 for lines starting with $
    "${SED_INPLACE[@]}" 's/^[[:space:]]*\$/     $   /' "$temp_file"

    # Only replace the original if changes were successful
    if [ $? -eq 0 ]; then
        mv "$temp_file" "$file"
    else
        rm -f "$temp_file"
        echo "Error processing $file"
        return 1
    fi

    echo "Done processing file: $file"
    echo ""
}

# Check if a filename is provided as an argument
if [[ $# -eq 1 ]]; then
    FILE="$1"
    if [[ -f "$FILE" ]] && is_fortran_file "$FILE"; then
        process_file "$FILE"
    else
        echo "Error: Provided file does not exist or is not a Fortran file."
        exit 1
    fi
else
    # Change to the core directory if no specific file is provided
    cd "$PROJECT_ROOT/core"
    
    # Process files in a deterministic order
    while IFS= read -r file; do
        if [[ -f "$file" ]] && is_fortran_file "$file"; then
            process_file "$file"
        fi
    done < <(find . -maxdepth 1 \( -name "*.f90" -o -name "NEKSTAB*" \) -type f | sort)
fi

# Clean up any remaining temporary files
find . -type f \( -name "*.tmp" -o -name "*~" \) -delete

echo "All done."