#!/bin/bash

# ============================================================================
# To create a conda environment suitable for NekStab/Nek5000 on macOS ARM:
#   conda create -n nek -c conda-forge gfortran openmpi cmake
#   conda activate nek
# ============================================================================

set -a # export all variables and functions defined in the script

# Initialize flags
debug=false
fresh=false
target=""

# Function to show usage
show_usage () {
    echo "Usage: $0 [case] [--debug] [--fresh]"
    echo "  case     : Case name to compile"
    echo "  --debug  : Enable debug mode"
    echo "  --fresh  : Clean before compilation"
    exit 1
}

# Function to manage compiler flags
manage_compiler_flags () {
    local action=$1
    local makenek_inc="$NEK_SOURCE_ROOT/core/makenek.inc"
    
    if [ ! -f "$makenek_inc" ]; then
        echo "Warning: makenek.inc not found at $makenek_inc"
        return
    fi
    
    case $action in
        "enable_debug")
            echo "Removing -w flag for debug mode"
            if [[ $(uname -s) == "Darwin" ]]; then
                sed -i '' 's/FF77="-w -std=legacy"/FF77=" -std=legacy"/' "$makenek_inc"
            else
                sed -i 's/FF77="-w -std=legacy"/FF77=" -std=legacy"/' "$makenek_inc"
            fi
            ;;
        "restore")
            echo "Restoring original compiler flags"
            if [[ $(uname -s) == "Darwin" ]]; then
                sed -i '' 's/FF77=" -std=legacy"/FF77="-w -std=legacy"/' "$makenek_inc"
            else
                sed -i 's/FF77=" -std=legacy"/FF77="-w -std=legacy"/' "$makenek_inc"
            fi
            ;;
    esac
}

# Parse command line arguments
# First argument should be the case name if not an option
if [[ $1 != --* && $1 != "" ]]; then
    target="$1"
    shift
fi

# Parse remaining options
while [[ $# -gt 0 ]]; do
    case $1 in
        --debug)
            debug=true
            shift
            ;;
        --fresh)
            fresh=true
            shift
            ;;
        --help|-h)
            show_usage
            ;;
        *)
            echo "Unknown option: $1"
            show_usage
            ;;
    esac
done

# Handle fresh (clean) operation if requested
if [ "$fresh" = true ]; then
    echo "Cleaning up build files..."
    make clean
    echo "Removing session and log files..."
    rm -f SESSION.NAME *log* makefile NEKSTAB.inc *.mod
    rm -f KRY* HES*
    echo "Cleanup completed."
    manage_compiler_flags "restore"
fi

# Fetch version information to print in the initialisation message
N_VERSION=$(git -C $NEK_SOURCE_ROOT describe --tag --long --always)
NS_VERSION=$(git -C $NEKSTAB_SOURCE_ROOT describe --tag --long --always)
FFLAGS="" # ensure empty here

# Handle debug mode
if [ "$debug" = true ]; then
    echo "Debug mode enabled"
    manage_compiler_flags "enable_debug"
fi

#-------------------------------------------------------------------------------
# Compiler Detection
#-------------------------------------------------------------------------------
# NEKSTAB_FC environment variable can force: "ifort", "ifx", or "gcc"
# CI environment uses portable flags (no CPU-specific optimizations)
if [ -n "$CI" ]; then
    echo "CI environment detected - using portable compiler flags"
fi

# Check for Intel compilers - prefer ifort (classic) if available, else ifx (LLVM)
if [ "$NEKSTAB_FC" = "ifx" ] && command -v ifx >/dev/null 2>&1; then
    # Forced ifx selection
    echo "Using Intel Compiler LLVM (ifx) [forced via NEKSTAB_FC]..."
    FC="mpiifx"
    CC="mpiicx"

    FFLAGS+=" -fixed"
    FFLAGS+=" -extend-source"
    # Use portable x86-64-v3 in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -march=x86-64-v3"  # AVX2 - portable across Intel/AMD
    else
        FFLAGS+=" -xHost"
    fi
    FFLAGS+=" -fno-strict-overflow"
    FFLAGS+=" -heap-arrays"
    FFLAGS+=" -mprefer-vector-width=512"
    FFLAGS+=" -align array64byte"

    export PPLIST="VENDOR_BLAS"
    # Dynamic MKL: best performance via runtime CPU dispatching
    # Note: Requires Intel environment at runtime (module load intel)
    if [ -z "$MKLROOT" ]; then
        echo "Warning: MKLROOT not set, MKL linking may fail"
    fi
    FFLAGS+=" -qmkl=sequential"

    if [ "$debug" = true ]; then
        echo "Debug mode enabled"
        FFLAGS+=" -g3 -traceback"
    fi

elif [ "$NEKSTAB_FC" = "gcc" ] || [ "$NEKSTAB_FC" = "gfortran" ]; then
    # Forced GCC selection - jump directly to GCC configuration
    FC="mpif90"
    CC="mpicc"
    echo "Using GCC (forced via NEKSTAB_FC)..."
    echo "Compiler found: $(which $FC)"
    echo "$($FC --version | head -n1)"

    FFLAGS+=" -ffixed-form"
    FFLAGS+=" -ffixed-line-length-none"
    # Use portable flags in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -mtune=generic"  # Portable across x86-64 CPUs
    else
        FFLAGS+=" -march=native"   # Native architecture optimization
    fi
    FFLAGS+=" -fno-lto" # Disable LTO to avoid linker issues with static archives (MPICH)

    if [ "$debug" = true ]; then
        echo "Debug mode enabled"
        FFLAGS+=" -g -fbacktrace"
        FFLAGS+=" -Wall -Wno-analyzer-out-of-bounds -Wno-zerotrip -frecursive"
    fi

    export PPLIST="VENDOR_BLAS"
    if [[ $(uname -s) == "Darwin" ]]; then
        USR_LFLAGS+=" -framework Accelerate"
        # FFTW3 from Homebrew (brew install fftw)
        if [ -d "/opt/homebrew/opt/fftw" ]; then
            USR_LFLAGS+=" -L/opt/homebrew/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/opt/homebrew/opt/fftw/include"
        elif [ -d "/usr/local/opt/fftw" ]; then
            USR_LFLAGS+=" -L/usr/local/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/usr/local/opt/fftw/include"
        fi
    else
        USR_LFLAGS+=" -llapack -lblas"
        # FFTW3 from system packages (apt install libfftw3-dev)
        USR_LFLAGS+=" -lfftw3"
    fi

elif command -v ifort >/dev/null 2>&1; then
    # Intel Classic (ifort) available
    echo "Using Intel Compiler Classic (ifort)..."
    FC="mpiifort"
    # Use mpiicx if icc is not available (Intel 2024+)
    if command -v icc >/dev/null 2>&1; then
        CC="mpiicc"
    else
        CC="mpiicx"
    fi

    FFLAGS+=" -fixed" # Nek5000 is in fixed form .f, while NekStab is in free form .f90
    FFLAGS+=" -extend-source" # Accepts line with longer than 72 characters (132 characters)

    MPIIFORT_VERSION=$(mpiifort --version | head -n 1)
    if [ "$MPIIFORT_VERSION" = "ifort (IFORT) 2021.9.0 20230302" ]; then
        echo "Detected mpiifort version 2021.9.0 20230302. Applying specific settings."
        CFLAGS+=" -diag-disable=10441 -diag-disable=42"
        FFLAGS+=" -diag-disable=10441 -warn noalign"
    elif [ -n "$CI" ]; then
        # No CPU-specific flags for CI - ifort's -x flags require Intel CPUs
        echo "CI: using generic optimization (no -xHost)"
    else
        FFLAGS+=" -xHost"
    fi

    export PPLIST="VENDOR_BLAS"
    # Dynamic MKL: best performance via runtime CPU dispatching
    # Note: Requires Intel environment at runtime (module load intel)
    if [ -z "$MKLROOT" ]; then
        echo "Warning: MKLROOT not set, MKL linking may fail"
    fi
    FFLAGS+=" -qmkl=sequential"

    # Handle debug mode for ifort
    if [ "$debug" = true ]; then
        echo "Debug mode enabled"
        FFLAGS+=" -g3 -traceback"
    fi

elif command -v ifx >/dev/null 2>&1; then
    # Intel LLVM (ifx) available - Intel 2025+
    echo "Using Intel Compiler LLVM (ifx)..."
    FC="mpiifx"
    CC="mpiicx"

    FFLAGS+=" -fixed" # Nek5000 is in fixed form .f, while NekStab is in free form .f90
    FFLAGS+=" -extend-source" # Accepts line with longer than 72 characters (132 characters)
    # Use portable flags in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -march=x86-64-v3"  # AVX2 - portable across Intel/AMD
    else
        FFLAGS+=" -xHost"
    fi
    # Compatibility flags for ifort behavior (prevent segfaults)
    FFLAGS+=" -fno-strict-overflow" # Integer overflow behavior like ifort
    FFLAGS+=" -heap-arrays" # Allocate arrays on heap instead of stack
    # Performance optimization flags for ifx
    FFLAGS+=" -mprefer-vector-width=512" # Encourage AVX-512 vectorization
    FFLAGS+=" -align array64byte" # 64-byte alignment for AVX-512 (5% speedup)

    export PPLIST="VENDOR_BLAS"
    # Dynamic MKL: best performance via runtime CPU dispatching
    # Note: Requires Intel environment at runtime (module load intel)
    if [ -z "$MKLROOT" ]; then
        echo "Warning: MKLROOT not set, MKL linking may fail"
    fi
    FFLAGS+=" -qmkl=sequential"

    # Handle debug mode
    if [ "$debug" = true ]; then
        echo "Debug mode enabled" # Ricardo's debugging flags
        FFLAGS+=" -g3 -traceback" # Enables stack tracing.
        # FFLAGS+=" -fpe-all=0" # Floating point exception trapping.
        # FFLAGS+=" -debug extended" # Enables all runtime checks.
        # FFLAGS+=" -check all,nobounds,nouninit" # Nek500 fails for array subscript/character substring expressions and uninitialized variables.
        # FFLAGS+=" -warn all,noexternal,nointerfaces -diag-enable remark" 
        # FFLAGS+=" -stand f18" # adhere strictly to the standards of f90/f95/f03/f08/f15 
    fi


else # GCC

    FC="mpif90"
    CC="mpicc"

    echo "Compiler found: $(which $FC)"
    echo "$($FC --version | head -n1)"

    FFLAGS+=" -ffixed-form" # Enables fixed-form source code, necessary as we mix .f90 files.
    FFLAGS+=" -ffixed-line-length-none" # Allows for any line length in fixed-form source code.
    # Use portable flags in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -mtune=generic"  # Portable across x86-64 CPUs
    else
        FFLAGS+=" -march=native"   # Native architecture optimization
    fi
    FFLAGS+=" -fno-lto" # Disable LTO to avoid linker issues with static archives (MPICH)

    if [ "$debug" = true ]; then # Handle debug mode
        echo "Debug mode enabled"
        FFLAGS+=" -g -fbacktrace" # Enables debugging information.
        # Add debug flags for GCC # -frecursive to stop max-stack-var-size
        FFLAGS+=" -Wall -Wno-analyzer-out-of-bounds -Wno-zerotrip -frecursive" # Additional flags for debugging
        echo "Added debug flags to FFLAGS"
    fi

    export PPLIST="VENDOR_BLAS"
    if [[ $(uname -s) == "Darwin" ]]; then
        USR_LFLAGS+=" -framework Accelerate"
        # FFTW3 from Homebrew (brew install fftw)
        if [ -d "/opt/homebrew/opt/fftw" ]; then
            USR_LFLAGS+=" -L/opt/homebrew/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/opt/homebrew/opt/fftw/include"
        elif [ -d "/usr/local/opt/fftw" ]; then
            USR_LFLAGS+=" -L/usr/local/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/usr/local/opt/fftw/include"
        fi
    else
        USR_LFLAGS+=" -llapack -lblas"
        # FFTW3 from system packages (apt install libfftw3-dev)
        USR_LFLAGS+=" -lfftw3"
    fi

    # Linking with OPENBLAS instead of LAPACK/BLAS (optional)
    # USR_LFLAGS+=" -I/usr/local/opt/openblas/include -L/usr/local/opt/openblas/lib -lopenblas"

fi
CFLAGS+=" -w" # supress C warnings 

#-------------------------------------------------------------------------------
# Conda/Library Path Handling (macOS & Linux)
#-------------------------------------------------------------------------------
# Only add conda lib paths if in a conda env, and mpif90 is NOT the conda-forge wrapper
# if [[ -n "$CONDA_PREFIX" ]]; then
#     mpif90_path=$(command -v mpif90)
#    # Always add conda lib paths if in a conda env
#     if [[ "$USR_LFLAGS" != *"-L$CONDA_PREFIX/lib"* ]]; then
#         USR_LFLAGS+=" -L$CONDA_PREFIX/lib"
#     fi
#     if [[ "$USR_LFLAGS" != *"-Wl,-rpath,$CONDA_PREFIX/lib"* ]]; then
#         USR_LFLAGS+=" -Wl,-rpath,$CONDA_PREFIX/lib"
#     fi
# fi

LD="$FC" # Linker (default to Fortran compiler as main program is in Fortran)
#-------------------------------------------------------------------------------
# Architecture Detection
#-------------------------------------------------------------------------------
case $(uname -s) in
Darwin)
    case $(uname -m) in
    x86_64)
        ;;
    arm64)
        FFLAGS+=" -mcmodel=small" # no support for large
        ;;
    esac
    ;;
Linux)
    case $(uname -p) in
    x86_64)
        FFLAGS+=" -mcmodel=large"
        ;;
    arm) # not tested
        ;;
    esac
    ;;
esac
#-------------------------------------------------------------------------------
# Final Preparations
#-------------------------------------------------------------------------------
# Allow extra flags via environment variable (for testing/optimization)
if [ -n "$NEKSTAB_EXTRA_FFLAGS" ]; then
    echo "Adding extra FFLAGS: $NEKSTAB_EXTRA_FFLAGS"
    FFLAGS+=" $NEKSTAB_EXTRA_FFLAGS"
fi

FFLAGS+=" -DNVERSION=\"'${N_VERSION}'\" -DNSVERSION=\"'${NS_VERSION}'\""

# User-specified object files
USR="nek_vectors.o"
USR+=" krylov_subspace.o"
USR+=" fourier_fftw.o"
USR+=" fourier.o"
USR+=" krylov_decomposition.o"
USR+=" argsort.o"
USR+=" matvec.o"
USR+=" eigensolvers.o"
USR+=" lapack_wrapper.o"
USR+=" fixedp.o"
USR+=" otd.o"
USR+=" forcing.o"
USR+=" main.o"
USR+=" utils.o"
USR+=" IO.o"
USR+=" postproc.o"
USR+=" newton_krylov.o"
USR+=" sensitivity.o"
USR+=" modal_analysis.o"

# Check if the makefile_usr file exists and source it
if [ -f "makefile_usr" ]; then
    source makefile_usr # add a case-specific custom one here !
fi
export USR

# Output summary of settings
echo "---------------- Compilation Details ----------------"
echo "Nek5000 version: $N_VERSION"
echo "nekStab version: $NS_VERSION"
echo "mpiexec version: $(mpiexec --version | head -n1) [$(which mpiexec)]"
echo "mpirun version: $(mpirun --version | head -n1) [$(which mpirun)]"
echo "---------------- C Compiler Details ----------------"
echo "CC compiler: $CC ($(which $CC 2>/dev/null || echo not found))"
echo "CC version: $($CC --version | head -n1)"
echo "CFLAGS: $CFLAGS"
echo "---------------- Fortran Compiler Details ----------------"
echo "FC compiler: $FC ($(which $FC 2>/dev/null || echo not found)) [LD : $LD]"
echo "FC version: $($FC --version | head -n1)"
echo "FFLAGS: $FFLAGS"
echo "USR_LFLAGS: $USR_LFLAGS"
echo "-----------------------------------------------------"

# Update makefile and static variables
cp -v $NEKSTAB_SOURCE_ROOT/src/NEKSTAB NEKSTAB.inc

# appends `include 'NEKSTAB.inc'` to `SIZE` if not present.
FILE="SIZE"
INCLUDE_LINE="include 'NEKSTAB.inc'" # respect spaces

# Check if the include line is present in the file
if grep -q "^ *$INCLUDE_LINE" "$FILE"; then
    echo "Include line '$INCLUDE_LINE' is already present in '$FILE'."
else
    echo "Include line '$INCLUDE_LINE' not found in '$FILE'. Appending the include line."

    # Append the include line to the file
    echo -e "\n$INCLUDE_LINE" >> "$FILE"

    # Verify the addition
    if grep -q "^ *$INCLUDE_LINE" "$FILE"; then
        echo "Include line '$INCLUDE_LINE' successfully appended to '$FILE'."
    else
        echo "Error: Failed to append the include line to '$FILE'."
    fi
fi

# Define the file and the lines to write
# We need to define NEKSTAB_SOURCE_ROOT as a makefile variable so that
# the rules in makefile_nekStab can use $(NEKSTAB_SOURCE_ROOT) reliably
FILE="makefile_usr.inc"
VAR_LINE="NEKSTAB_SOURCE_ROOT = $NEKSTAB_SOURCE_ROOT"
INCLUDE_LINE='include $(NEKSTAB_SOURCE_ROOT)/src/makefile_nekStab'

# Always rewrite makefile_usr.inc to ensure correct paths
echo "Creating/updating $FILE with NEKSTAB_SOURCE_ROOT=$NEKSTAB_SOURCE_ROOT"
echo "$VAR_LINE" > "$FILE"
echo "$INCLUDE_LINE" >> "$FILE"

: ${NEK_SOURCE_ROOT:="$HOME/Nek5000"}
set +a -e
$NEK_SOURCE_ROOT/bin/nekconfig "$target"
$NEK_SOURCE_ROOT/bin/nekconfig -build-dep
set -o pipefail
touch ${target}.usr

# Unset FFLAGS/CFLAGS to prevent make from reading them twice (makefile + environment)
unset FFLAGS CFLAGS
make -j4 2>&1 | tee -a build.log
set +o pipefail
if [ $(ls *.mod 2>/dev/null | wc -l) -gt 0 ]; then
    mv *.mod obj
fi

# Restore original compiler flags if debug mode was enabled
if [ "$debug" = true ]; then
    manage_compiler_flags "restore"
fi