#!/bin/bash

# ============================================================================
# To create a conda environment suitable for NekStab/Nek5000 on macOS ARM:
#   conda create -n nek -c conda-forge gfortran openmpi cmake
#   conda activate nek
# ============================================================================

set -a # export all variables and functions defined in the script

# Initialize flags
debug=false
fresh=false
target=""

#-------------------------------------------------------------------------------
# Helper Functions
#-------------------------------------------------------------------------------

show_usage () {
    echo "Usage: $0 [case] [--debug] [--fresh]"
    echo "  case     : Case name to compile"
    echo "  --debug  : Enable debug mode"
    echo "  --fresh  : Clean before compilation"
    exit 1
}

# Cross-platform sed -i (macOS requires '' argument)
sed_inplace () {
    if [[ $(uname -s) == "Darwin" ]]; then
        sed -i '' "$@"
    else
        sed -i "$@"
    fi
}

manage_compiler_flags () {
    local action=$1
    local makenek_inc="$NEK_SOURCE_ROOT/core/makenek.inc"

    if [ ! -f "$makenek_inc" ]; then
        echo "Warning: makenek.inc not found at $makenek_inc"
        return
    fi

    case $action in
        "enable_debug")
            echo "Removing -w flag for debug mode"
            sed_inplace 's/FF77="-w -std=legacy"/FF77=" -std=legacy"/' "$makenek_inc"
            ;;
        "restore")
            echo "Restoring original compiler flags"
            sed_inplace 's/FF77=" -std=legacy"/FF77="-w -std=legacy"/' "$makenek_inc"
            ;;
    esac
}

do_clean () {
    echo "Cleaning up build files..."
    [ -f makefile ] && make clean
    echo "Removing session and log files..."
    rm -f SESSION.NAME *log* makefile NEKSTAB.inc *.mod KRY* HES*
    echo "Cleanup completed."
    manage_compiler_flags "restore"
}

# Intel compiler common flags (shared by ifx and ifort)
setup_intel_common_flags () {
    FFLAGS+=" -fpp"             # Fortran preprocessor
    FFLAGS+=" -r8 -fpconstant"  # Double precision reals
    FFLAGS+=" -fixed"
    FFLAGS+=" -extend-source"

    export PPLIST="VENDOR_BLAS"
    if [ -z "$MKLROOT" ]; then
        echo "Warning: MKLROOT not set, MKL linking may fail"
    fi
    FFLAGS+=" -qmkl=sequential"

    if [ "$debug" = true ]; then
        echo "Debug mode enabled"
        FFLAGS+=" -g3 -traceback"
    fi
}

# ifx-specific flags (Intel LLVM)
setup_ifx_flags () {
    FC="mpiifx"
    CC="mpiicx"

    setup_intel_common_flags

    # Use portable x86-64-v3 in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -march=x86-64-v3"  # AVX2 - portable across Intel/AMD
    else
        FFLAGS+=" -xHost"
    fi

    # Compatibility and performance flags for ifx
    FFLAGS+=" -fno-strict-overflow"        # Integer overflow behavior like ifort
    FFLAGS+=" -heap-arrays"                # Allocate arrays on heap instead of stack
    FFLAGS+=" -mprefer-vector-width=512"   # Encourage AVX-512 vectorization
    FFLAGS+=" -align array64byte"          # 64-byte alignment for AVX-512
}

# ifort-specific flags (Intel Classic)
setup_ifort_flags () {
    FC="mpiifort"
    # Use mpiicx if icc is not available (Intel 2024+)
    if command -v icc >/dev/null 2>&1; then
        CC="mpiicc"
    else
        CC="mpiicx"
    fi

    setup_intel_common_flags

    # Extract ifort version for version-specific settings
    MPIIFORT_VERSION_FULL=$(mpiifort --version 2>&1 | grep "(IFORT)" | head -n 1)
    IFORT_VERSION=$(echo "$MPIIFORT_VERSION_FULL" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    IFORT_MINOR=$(echo "$IFORT_VERSION" | cut -d. -f2)
    echo "Detected ifort version: $IFORT_VERSION"

    if [ "$IFORT_VERSION" = "2021.9.0" ]; then
        echo "Applying ifort 2021.9.0 specific settings."
        CFLAGS+=" -diag-disable=10441 -diag-disable=42"
        FFLAGS+=" -diag-disable=10441 -warn noalign"
    elif [ "$IFORT_MINOR" -ge 13 ] 2>/dev/null; then
        echo "Suppressing ifort deprecation warning (remark #10448)."
        FFLAGS+=" -diag-disable=10448"
    fi

    # Add xHost for native optimization (skip in CI)
    if [ -z "$CI" ]; then
        FFLAGS+=" -xHost"
    else
        echo "CI: using generic optimization (no -xHost)"
    fi
}

# GCC/gfortran flags
setup_gcc_flags () {
    FC="mpif90"
    CC="mpicc"

    echo "Compiler found: $(which $FC)"
    echo "$($FC --version | head -n1)"

    FFLAGS+=" -cpp"                                  # C preprocessor
    FFLAGS+=" -fdefault-real-8 -fdefault-double-8"   # Double precision reals
    FFLAGS+=" -w -std=legacy"                        # Suppress warnings, legacy extensions
    FFLAGS+=" -ffixed-form"
    FFLAGS+=" -ffixed-line-length-none"
    FFLAGS+=" -fno-lto"  # Disable LTO to avoid linker issues with static archives

    # Use portable flags in CI, native optimization otherwise
    if [ -n "$CI" ]; then
        FFLAGS+=" -mtune=generic"
    else
        FFLAGS+=" -march=native"
    fi

    if [ "$debug" = true ]; then
        echo "Debug mode enabled"
        FFLAGS+=" -g -fbacktrace"
        FFLAGS+=" -Wall -Wno-analyzer-out-of-bounds -Wno-zerotrip -frecursive"
    fi

    export PPLIST="VENDOR_BLAS"
    if [[ $(uname -s) == "Darwin" ]]; then
        USR_LFLAGS+=" -framework Accelerate"
        # FFTW3 from Homebrew
        if [ -d "/opt/homebrew/opt/fftw" ]; then
            USR_LFLAGS+=" -L/opt/homebrew/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/opt/homebrew/opt/fftw/include"
        elif [ -d "/usr/local/opt/fftw" ]; then
            USR_LFLAGS+=" -L/usr/local/opt/fftw/lib -lfftw3"
            FFLAGS+=" -I/usr/local/opt/fftw/include"
        fi
    else
        USR_LFLAGS+=" -llapack -lblas -lfftw3"
    fi
}

#-------------------------------------------------------------------------------
# Argument Parsing
#-------------------------------------------------------------------------------

# First argument is the case name if not an option
if [[ $1 != --* && $1 != "" ]]; then
    target="$1"
    shift
fi

# Handle "clean" command
if [ "$target" = "clean" ]; then
    do_clean
    exit 0
fi

# Parse remaining options
while [[ $# -gt 0 ]]; do
    case $1 in
        --debug) debug=true; shift ;;
        --fresh) fresh=true; shift ;;
        --help|-h) show_usage ;;
        *) echo "Unknown option: $1"; show_usage ;;
    esac
done

# Handle fresh (clean + rebuild)
if [ "$fresh" = true ]; then
    do_clean
fi

#-------------------------------------------------------------------------------
# Version Information
#-------------------------------------------------------------------------------

N_VERSION=$(git -C $NEK_SOURCE_ROOT describe --tag --long --always)
NS_VERSION=$(git -C $NEKSTAB_SOURCE_ROOT describe --tag --long --always)
FFLAGS=""

if [ "$debug" = true ]; then
    echo "Debug mode enabled"
    manage_compiler_flags "enable_debug"
fi

#-------------------------------------------------------------------------------
# Compiler Detection
#-------------------------------------------------------------------------------
# NEKSTAB_FC environment variable can force compiler selection:
#   - "ifx"     : Intel LLVM compiler (recommended, modern)
#   - "ifort"   : Intel Classic compiler (deprecated, for benchmarking)
#   - "gcc"     : GCC/gfortran (portable, fallback)

if [ -n "$CI" ]; then
    echo "CI environment detected - using portable compiler flags"
fi

if [ "$NEKSTAB_FC" = "ifx" ] && command -v ifx >/dev/null 2>&1; then
    echo "Using Intel Compiler LLVM (ifx) [forced via NEKSTAB_FC]..."
    setup_ifx_flags

elif [ "$NEKSTAB_FC" = "ifort" ] && command -v ifort >/dev/null 2>&1; then
    echo "Using Intel Compiler Classic (ifort) [forced via NEKSTAB_FC]..."
    setup_ifort_flags

elif [ "$NEKSTAB_FC" = "gcc" ] || [ "$NEKSTAB_FC" = "gfortran" ]; then
    echo "Using GCC (forced via NEKSTAB_FC)..."
    setup_gcc_flags

elif command -v ifx >/dev/null 2>&1; then
    echo "Using Intel Compiler LLVM (ifx)..."
    setup_ifx_flags

elif command -v ifort >/dev/null 2>&1; then
    echo "Using Intel Compiler Classic (ifort)..."
    setup_ifort_flags

else
    setup_gcc_flags
fi

CFLAGS+=" -w"  # suppress C warnings

#-------------------------------------------------------------------------------
# Architecture Detection
#-------------------------------------------------------------------------------

case $(uname -s) in
    Darwin)
        [[ $(uname -m) == "arm64" ]] && FFLAGS+=" -mcmodel=small"
        ;;
    Linux)
        [[ $(uname -p) == "x86_64" ]] && FFLAGS+=" -mcmodel=large"
        ;;
esac

#-------------------------------------------------------------------------------
# Final Preparations
#-------------------------------------------------------------------------------

# Allow extra flags via environment variable
if [ -n "$NEKSTAB_EXTRA_FFLAGS" ]; then
    echo "Adding extra FFLAGS: $NEKSTAB_EXTRA_FFLAGS"
    FFLAGS+=" $NEKSTAB_EXTRA_FFLAGS"
fi

FFLAGS+=" -DNVERSION=\"'${N_VERSION}'\" -DNSVERSION=\"'${NS_VERSION}'\""

LD="$FC"  # Linker (Fortran compiler as main program is Fortran)

# User-specified object files
USR="nek_vectors.o"
USR+=" krylov_subspace.o"
USR+=" fourier_fftw.o"
USR+=" fourier.o"
USR+=" krylov_decomposition.o"
USR+=" argsort.o"
USR+=" matvec.o"
USR+=" eigensolvers.o"
USR+=" lapack_wrapper.o"
USR+=" fixedp.o"
USR+=" otd.o"
USR+=" forcing.o"
USR+=" main.o"
USR+=" utils.o"
USR+=" IO.o"
USR+=" postproc.o"
USR+=" newton_krylov.o"
USR+=" sensitivity.o"
USR+=" modal_analysis.o"

# Source case-specific makefile if present
[ -f "makefile_usr" ] && source makefile_usr
export USR

# Output summary
echo "---------------- Compilation Details ----------------"
echo "Nek5000 version: $N_VERSION"
echo "nekStab version: $NS_VERSION"
echo "mpiexec version: $(mpiexec --version | head -n1) [$(which mpiexec)]"
echo "mpirun version: $(mpirun --version | head -n1) [$(which mpirun)]"
echo "---------------- C Compiler Details ----------------"
echo "CC compiler: $CC ($(which $CC 2>/dev/null || echo not found))"
echo "CC version: $($CC --version | head -n1)"
echo "CFLAGS: $CFLAGS"
echo "---------------- Fortran Compiler Details ----------------"
echo "FC compiler: $FC ($(which $FC 2>/dev/null || echo not found)) [LD : $LD]"
echo "FC version: $($FC --version | head -n1)"
echo "FFLAGS: $FFLAGS"
echo "USR_LFLAGS: $USR_LFLAGS"
echo "-----------------------------------------------------"

# Update makefile and static variables
cp -v $NEKSTAB_SOURCE_ROOT/src/NEKSTAB NEKSTAB.inc

# Append 'include NEKSTAB.inc' to SIZE if not present
FILE="SIZE"
INCLUDE_LINE="include 'NEKSTAB.inc'"
if ! grep -q "^ *$INCLUDE_LINE" "$FILE"; then
    echo "Appending '$INCLUDE_LINE' to '$FILE'."
    echo -e "\n$INCLUDE_LINE" >> "$FILE"
fi

# Create makefile_usr.inc with NEKSTAB_SOURCE_ROOT
FILE="makefile_usr.inc"
echo "Creating/updating $FILE with NEKSTAB_SOURCE_ROOT=$NEKSTAB_SOURCE_ROOT"
echo "NEKSTAB_SOURCE_ROOT = $NEKSTAB_SOURCE_ROOT" > "$FILE"
echo 'include $(NEKSTAB_SOURCE_ROOT)/src/makefile_nekStab' >> "$FILE"

: ${NEK_SOURCE_ROOT:="$HOME/Nek5000"}
set +a -e
$NEK_SOURCE_ROOT/bin/nekconfig "$target"
$NEK_SOURCE_ROOT/bin/nekconfig -build-dep
set -o pipefail
touch ${target}.usr

# Override Nek5000's auto-detected flags with our complete set
if [ -f makefile ]; then
    echo "Overriding FFLAGS in generated makefile..."
    sed_inplace "s/^FFLAGS+=.*/FFLAGS+=${FFLAGS}/" makefile
    if [ -n "$NEKSTAB_OPT" ]; then
        echo "Overriding optimization level: L2 = $NEKSTAB_OPT"
        sed_inplace "s/^L2 = .*/L2 = $NEKSTAB_OPT/" makefile
    fi
fi

# Unset FFLAGS/CFLAGS to prevent make from reading them twice
unset FFLAGS CFLAGS
make -j4 2>&1 | tee -a build.log
set +o pipefail

# Move .mod files to obj/ if it exists, otherwise remove them
if ls *.mod >/dev/null 2>&1; then
    [ -d obj ] && mv *.mod obj || rm -f *.mod
fi

# Restore original compiler flags if debug mode was enabled
[ "$debug" = true ] && manage_compiler_flags "restore" || true
