root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Fortran fixed-form (Nek5000 legacy)
[*.f]
indent_style = space
indent_size = 3
trim_trailing_whitespace = true
max_line_length = 132
insert_final_newline = true

# Fortran free-form (nekStab modern)
[*.{f90,F90}]
indent_style = space
indent_size = 3
trim_trailing_whitespace = true
max_line_length = 132
insert_final_newline = true

[Makefile]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 132
insert_final_newline = true

[*.sh]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 132
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
